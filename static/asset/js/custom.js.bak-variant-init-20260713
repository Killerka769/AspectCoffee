function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== '') {
        const cookies = document.cookie.split(';');
        for (let i = 0; i < cookies.length; i++) {
            const cookie = cookies[i].trim();
            if (cookie.substring(0, name.length + 1) === (name + '=')) {
                cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                break;
            }
        }
    }
    return cookieValue;
}

function showToast(message, type) {
    let container = document.getElementById('toast-container');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'toast-container';
        document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    toast.className = 'toast toast-' + (type || 'info');
    toast.textContent = message;
    container.appendChild(toast);
    requestAnimationFrame(() => { toast.classList.add('toast-show'); });
    setTimeout(() => {
        toast.classList.remove('toast-show');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

function safeJsonParse(raw, fallback) {
    try {
        return JSON.parse(raw);
    } catch (e) {
        return fallback;
    }
}

function updateCompareBadge(count) {
    let badge = document.getElementById('compare-badge');
    const wrap = document.querySelector('.header-compare__btn');
    if (!badge && wrap && count > 0) {
        badge = document.createElement('span');
        badge.id = 'compare-badge';
        badge.style.cssText = 'position:absolute;top:-4px;right:-6px;background:#000;color:#fff;font-size:10px;font-weight:700;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;line-height:1;border:2px solid #fff;';
        wrap.appendChild(badge);
    }
    if (!badge) return;
    badge.textContent = count;
    badge.style.display = count > 0 ? 'flex' : 'none';
}

function syncCompareCookie(count) {
    document.cookie = 'tc_compare_count=' + count + '; path=/; max-age=31536000; SameSite=Lax';
}

function getLocalWishlist() {
    return safeJsonParse(localStorage.getItem('wishlist') || '[]', []).map(Number).filter(Boolean);
}

function setLocalWishlist(list) {
    const unique = Array.from(new Set(list.map(Number).filter(Boolean)));
    localStorage.setItem('wishlist', JSON.stringify(unique));
    updateWishlistBadge(unique.length);
    return unique;
}

function updateWishlistBadge(count) {
    let badge = document.getElementById('wishlist-badge');
    const wrap = document.getElementById('wishlist-badge-wrap');
    if (!badge && wrap) {
        badge = document.createElement('span');
        badge.id = 'wishlist-badge';
        badge.style.cssText = 'position:absolute;top:-4px;right:-6px;background:#000;color:#fff;font-size:10px;font-weight:700;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;line-height:1;border:2px solid #fff;';
        wrap.appendChild(badge);
    }
    if (!badge) {
        console.log('Wishlist badge not found and wrap not found');
        return;
    }
    badge.textContent = count;
    badge.style.display = count > 0 ? 'flex' : 'none';
    console.log('Wishlist badge updated:', count, 'display:', badge.style.display);
}

function tcCopyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text);
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    document.body.appendChild(textarea);
    textarea.select();
    const ok = document.execCommand('copy');
    textarea.remove();
    return ok ? Promise.resolve() : Promise.reject(new Error('copy failed'));
}

function compareLabel(n) {
    var last2 = n % 100, last1 = n % 10;
    if (last2 >= 11 && last2 <= 14) return n + ' товаров в сравнении';
    if (last1 === 1) return n + ' товар в сравнении';
    if (last1 >= 2 && last1 <= 4) return n + ' товара в сравнении';
    return n + ' товаров в сравнении';
}

var _compareBarTimer = null;

function updateCompareBar() {
    const list = safeJsonParse(localStorage.getItem('compare') || '[]', []);
    updateCompareBadge(list.length);
    syncCompareCookie(list.length);
    let bar = document.getElementById('compare-bar');
    if (list.length === 0) {
        if (bar) bar.style.display = 'none';
        if (_compareBarTimer) { clearTimeout(_compareBarTimer); _compareBarTimer = null; }
        return;
    }
    if (!bar) {
        bar = document.createElement('div');
        bar.id = 'compare-bar';
        bar.className = 'compare-bar';
        document.body.appendChild(bar);
    }
    var lastShow = parseInt(localStorage.getItem('compare_bar_shown') || '0', 10);
    var now = Date.now();
    if (now - lastShow < 15000) {
        bar.style.display = 'block';
        bar.innerHTML = '<div class="compare-bar-inner"><span class="compare-bar-count">' + compareLabel(list.length) + '</span><a href="/catalog/compare/?ids=' + list.join(',') + '" class="compare-bar-link">Сравнить</a><button class="compare-bar-clear" onclick="clearCompare()">Очистить</button></div>';
        if (_compareBarTimer) clearTimeout(_compareBarTimer);
        _compareBarTimer = setTimeout(function() { bar.style.display = 'none'; }, 15000 - (now - lastShow));
    } else {
        bar.style.display = 'none';
    }
}

function showCompareBar() {
    localStorage.setItem('compare_bar_shown', String(Date.now()));
    updateCompareBar();
}

function clearCompare() {
    localStorage.setItem('compare', '[]');
    document.body.dispatchEvent(new CustomEvent('compareUpdated', { bubbles: true }));
    updateCompareBar();
    showToast('Список сравнения очищен');
    if (window.location.pathname.startsWith('/catalog/compare')) {
        window.location.href = '/catalog/compare/';
    }
}

document.addEventListener('alpine:init', () => {
    Alpine.data('productCard', (config) => ({
        id: config.id,
        slug: config.slug,
        inStock: config.inStock,
        weight: 250,
        grind: 'whole',
        roast: '',
        variants: [],
        currentVariant: null,
        variantMessage: '',
        justAdded: false,
        cartQty: 0,
        inWishlist: config.inWishlist || false,
        inCompare: false,
        hasNote: false,
        tooltipOpen: false,
        grindOpen: false,
        grindLabels: {
            'whole': 'в зёрнах',
            'medium': 'средний помол',
            'fine': 'мелкий помол',
            'coarse': 'для турки'
        },

        init() {
            const el = this.$el.querySelector('.variants-data');
            if (el) {
                try {
                    this.variants = JSON.parse(el.textContent);
                    if (this.variants.length) {
                        this.weight = this.variants[0].weight;
                        this.grind = this.variants[0].grind;
                        this.roast = this.variants[0].roast || '';
                    }
                    this.updateCurrentVariant();
                } catch (e) {
                    console.error("Error parsing variants for product", this.id, e);
                }
            }
            const compareList = JSON.parse(localStorage.getItem('compare') || '[]');
            this.inCompare = compareList.some(id => Number(id) === Number(this.id));
            if (!document.body.dataset.authenticated) {
                // Guest: read wishlist from localStorage
                this.inWishlist = getLocalWishlist().includes(this.id);
            }
            // Authenticated: inWishlist already set from server-rendered wishlist_ids (config.inWishlist)
            // — do NOT override with localStorage here.
            const notes = JSON.parse(localStorage.getItem('product_notes') || '{}');
            if (notes[this.id]) {
                this.hasNote = true;
            }
            var self = this;
            document.body.addEventListener('compareUpdated', function() {
                var list = JSON.parse(localStorage.getItem('compare') || '[]');
                self.inCompare = list.some(function(id) { return Number(id) === Number(self.id); });
            });
            document.body.addEventListener('noteUpdated', function(e) {
                if (e.detail && e.detail.productId === self.id) {
                    self.hasNote = e.detail.hasNote;
                }
            });
            // Bug fix: закрываем grind-дропдаун, если открылся другой
            document.addEventListener('closeAllGrindDropdowns', function(e) {
                if (e.detail && e.detail.exceptId !== self.id) {
                    self.grindOpen = false;
                }
            });
            // Check cart state AFTER all init is done
            this.checkCartState();
            // Re-check cart state when cart is updated (e.g. cleared from mini-cart)
            document.body.addEventListener('cartUpdated', () => {
                this.checkCartState();
            });
        },

        // 1.7.4 — комбинации помол × обжарка для текущей фасовки (выпадающий список).
        get combos() {
            const seen = {};
            const out = [];
            this.variants.filter(v => v.weight === this.weight).forEach(v => {
                const key = v.grind + '|' + (v.roast || '');
                if (!seen[key]) {
                    seen[key] = true;
                    const gl = v.grind_label || this.grindLabels[v.grind] || v.grind;
                    const rl = v.roast_label || '';
                    out.push({ grind: v.grind, roast: v.roast || '', label: rl ? (gl + ' / ' + rl) : gl });
                }
            });
            return out;
        },

        get currentComboLabel() {
            const c = this.combos.find(c => c.grind === this.grind && c.roast === this.roast);
            return c ? c.label : (this.grindLabels[this.grind] || 'в зёрнах');
        },

        updateCurrentVariant() {
            this.currentVariant = this.variants.find(
                v => v.weight === this.weight && v.grind === this.grind && (v.roast || '') === (this.roast || '')
            ) || null;
            if (!this.currentVariant && this.variants.length) {
                this.currentVariant = this.variants.find(v => v.weight === this.weight) || this.variants[0];
                if (this.currentVariant) {
                    this.grind = this.currentVariant.grind;
                    this.roast = this.currentVariant.roast || '';
                }
            }
            this.variantMessage = '';
        },

        syncCartState() {
            if (!this.currentVariant) return;
            const cartData = window.__CART_VARIANT_IDS__ || {};
            if (cartData[this.currentVariant.id]) {
                this.justAdded = true;
                this.cartQty = cartData[this.currentVariant.id];
            } else {
                this.justAdded = false;
                this.cartQty = 0;
            }
        },

        isWeightAvailable(w) {
            return this.variants.some(v => v.weight === w);
        },
        isGrindAvailable(g) {
            return this.variants.some(v => v.weight === this.weight && v.grind === g);
        },

        setWeight(w) {
            this.weight = w;
            if (!this.variants.some(v => v.weight === w && v.grind === this.grind && (v.roast || '') === (this.roast || ''))) {
                const first = this.variants.find(v => v.weight === w);
                if (first) { this.grind = first.grind; this.roast = first.roast || ''; }
            }
            this.updateCurrentVariant();
            this.syncCartState();
        },

        setGrind(g) {
            this.grind = g;
            this.updateCurrentVariant();
            this.syncCartState();
        },

        // 1.7 — выбор комбинации помол+обжарка.
        setCombo(grind, roast) {
            this.grind = grind;
            this.roast = roast || '';
            this.updateCurrentVariant();
            this.syncCartState();
        },

        // Check if this product is in cart on page load (from server-side data)
        checkCartState() {
            fetch('/basket/data.json', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(cartData => {
                    window.__CART_VARIANT_IDS__ = cartData;
                    const variantIds = this.variants.map(v => v.id);
                    for (const vid of variantIds) {
                        if (cartData[vid]) {
                            this.justAdded = true;
                            this.cartQty = cartData[vid];
                            return;
                        }
                    }
                    this.justAdded = false;
                    this.cartQty = 0;
                })
                .catch(() => {
                    const cartData = window.__CART_VARIANT_IDS__ || {};
                    const variantIds = this.variants.map(v => v.id);
                    for (const vid of variantIds) {
                        if (cartData[vid]) {
                            this.justAdded = true;
                            this.cartQty = cartData[vid];
                            return;
                        }
                    }
                    this.justAdded = false;
                    this.cartQty = 0;
                });
        },

        get currentPrice() {
            if (this.currentVariant) {
                return Math.round(this.currentVariant.price);
            }
            return config.price || '—';
        },

        // Update mini-cart badge and content instantly
        updateCartBadge() {
            const badge = document.getElementById('header-cart-badge');
            if (!badge) return;
            var priceSpan = badge.querySelector('span.block');
            var qtyDiv = badge.querySelectorAll('.pl-2 > div')[1];
            var qtySpan = qtyDiv ? qtyDiv.querySelector('span.block') : null;
            if (priceSpan) priceSpan.textContent = (window.__CART_TOTAL_PRICE__ || 0);
            if (qtySpan) qtySpan.textContent = (window.__CART_TOTAL_QTY__ || 0);
        },

        async addToCart() {
            if (!this.currentVariant) return;
            
            try {
                const response = await fetch('/basket/add/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-CSRFToken': getCookie('csrftoken'),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: `variant_id=${this.currentVariant.id}&qty=1`
                });
                
                if (response.ok) {
                    const data = await response.json();
                    this.justAdded = true;
                    this.cartQty = 1;
                    if (!window.__CART_VARIANT_IDS__) window.__CART_VARIANT_IDS__ = {};
                    window.__CART_VARIANT_IDS__[this.currentVariant.id] = this.cartQty;
                    window.__CART_TOTAL_QTY__ = data.total_items || 0;
                    window.__CART_TOTAL_PRICE__ = parseFloat(data.total) || 0;
                    this.updateCartBadge();
                } else {
                    const data = await response.json();
                    window.dispatchEvent(new CustomEvent('notify', {
                        detail: { message: data.error || 'Ошибка при добавлении', type: 'error' }
                    }));
                }
            } catch (e) {
                console.error("Cart error:", e);
            }
        },

        async incrementCart() {
            if (!this.currentVariant) return;
            this.cartQty++;
            if (!window.__CART_VARIANT_IDS__) window.__CART_VARIANT_IDS__ = {};
            window.__CART_VARIANT_IDS__[this.currentVariant.id] = this.cartQty;
            this.updateCartBadge();
            fetch('/basket/update/' + this.currentVariant.id + '/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRFToken': getCookie('csrftoken'),
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `qty=${this.cartQty}`
            }).then(r => r.json()).then(data => {
                window.__CART_TOTAL_QTY__ = data.total_items || 0;
                window.__CART_TOTAL_PRICE__ = parseFloat(data.total) || 0;
                this.updateCartBadge();
            }).catch(() => {});
        },

        async decrementCart() {
            if (!this.currentVariant || this.cartQty <= 0) return;
            this.cartQty--;
            if (this.cartQty === 0) {
                this.justAdded = false;
                if (window.__CART_VARIANT_IDS__) delete window.__CART_VARIANT_IDS__[this.currentVariant.id];
            } else {
                if (!window.__CART_VARIANT_IDS__) window.__CART_VARIANT_IDS__ = {};
                window.__CART_VARIANT_IDS__[this.currentVariant.id] = this.cartQty;
            }
            this.updateCartBadge();
            fetch('/basket/update/' + this.currentVariant.id + '/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRFToken': getCookie('csrftoken'),
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `qty=${this.cartQty}`
            }).then(r => r.json()).then(data => {
                window.__CART_TOTAL_QTY__ = data.total_items || 0;
                window.__CART_TOTAL_PRICE__ = parseFloat(data.total) || 0;
                this.updateCartBadge();
            }).catch(() => {});
        },

        async toggleWishlist() {
            const wasInWishlist = this.inWishlist;
            this.inWishlist = !this.inWishlist;

            if (!document.body.dataset.authenticated) {
                // Guest: toggle wishlist in localStorage (no redirect to login)
                let localWish = getLocalWishlist();
                const numId = Number(this.id);
                if (this.inWishlist) {
                    if (!localWish.includes(numId)) localWish.push(numId);
                    showToast('Добавлено в избранное');
                } else {
                    localWish = localWish.filter(id => id !== numId);
                    showToast('Убрано из избранного');
                }
                setLocalWishlist(localWish);
                updateWishlistBadge(localWish.length);
                return;
            }

            try {
                const resp = await fetch('/account/wishlist/toggle/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-CSRFToken': getCookie('csrftoken'),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: 'product_id=' + this.id + '&add=' + this.inWishlist
                });

                if (resp.status === 401) {
                    this.inWishlist = wasInWishlist;
                    window.location.href = '/login/?next=' + encodeURIComponent(window.location.pathname + window.location.search);
                    return;
                }

                if (!resp.ok) {
                    this.inWishlist = wasInWishlist;
                    const data = await resp.json();
                    window.dispatchEvent(new CustomEvent('notify', {
                        detail: { message: data.error || 'Ошибка', type: 'error' }
                    }));
                } else {
                    const data = await resp.json();
                    updateWishlistBadge(data.total_count);
                    document.body.dispatchEvent(new CustomEvent('wishlistUpdated', { detail: { count: data.total_count } }));
                }
            } catch (e) {
                this.inWishlist = wasInWishlist;
            }
        },
        toggleCompare() {
            let list = JSON.parse(localStorage.getItem('compare') || '[]');
            const numId = Number(this.id);
            const wasIn = list.some(id => Number(id) === numId);
            if (wasIn) {
                list = list.filter(id => Number(id) !== numId);
                this.inCompare = false;
                showToast('Товар убран из сравнения');
            } else {
                if (list.length >= 4) {
                    showToast('Можно сравнивать максимум 4 товара', 'error');
                    return;
                }
                list.push(numId);
                this.inCompare = true;
                showToast('Товар добавлен к сравнению');
            }
            localStorage.setItem('compare', JSON.stringify(list));
            if (wasIn) {
                document.body.dispatchEvent(new CustomEvent('compareUpdated', { bubbles: true }));
            } else {
                showCompareBar();
            }
        },
        toggleNote() {
            var store = Alpine.store('note');
            store._ensureModal();
            store.productId = this.id;
            var notes = JSON.parse(localStorage.getItem('product_notes') || '{}');
            store.text = notes[this.id] || '';
            var hasExisting = !!notes[this.id];
            document.getElementById('note-textarea').value = store.text;
            document.getElementById('note-save').textContent = hasExisting ? 'Удалить' : 'Сохранить';
            document.getElementById('note-save').style.background = hasExisting ? '#dc2626' : 'black';
            var m = document.getElementById('note-modal');
            store.open = true;
            m.style.display = 'block';
        },
        clearNote() {
            const notes = JSON.parse(localStorage.getItem('product_notes') || '{}');
            delete notes[this.id];
            localStorage.setItem('product_notes', JSON.stringify(notes));
            this.hasNote = false;
            Alpine.store('note').open = false;
            var m = document.getElementById('note-modal');
            if (m) m.style.display = 'none';
            showToast('Заметка удалена');
        },
        navigateCard(e) {
            // Если открыт любой поповер карточки (выбор помола/обжарки или заметка) —
            // не переходим на карточку: клик предназначен попап-меню, не навигации.
            if (this.grindOpen || this.noteOpen) return;
            // If user clicked any interactive element inside the card, do nothing.
            let interactive = false;
            if (typeof e.composedPath === 'function') {
                interactive = e.composedPath().some(el => {
                    if (el && el.matches) {
                        return el.matches('a, button, select, input, textarea, label, [data-no-card-nav]');
                    }
                    return false;
                });
            } else {
                interactive = e.target.closest('a, button, select, input, textarea, label, [data-no-card-nav]');
            }
            if (interactive) return;
            const url = this.$el.getAttribute('data-product-url');
            if (url) window.location.href = url;
        },
        openReviewModal() {
            const url = this.$el.getAttribute('data-product-url') || ('/coffee/' + this.slug + '/');
            if (!document.body.dataset.authenticated) {
                window.location.href = '/login/?next=' + encodeURIComponent(url + '#reviews');
                return;
            }
            window.location.href = url + '#reviews';
        }
    }));

    Alpine.data('communityLike', (config) => ({
        id: config.id,
        liked: config.liked || false,
        count: config.count || 0,
        async toggle() {
            const wasLiked = this.liked;
            const wasCount = this.count;
            this.liked = !this.liked;
            this.count += this.liked ? 1 : -1;
            try {
                const resp = await fetch('/community/post/' + this.id + '/like/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-CSRFToken': getCookie('csrftoken'),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: 'add=' + this.liked
                });

                if (resp.status === 401) {
                    this.liked = wasLiked;
                    this.count = wasCount;
                    window.location.href = '/login/?next=' + encodeURIComponent(window.location.pathname);
                    return;
                }

                if (!resp.ok) {
                    this.liked = wasLiked;
                    this.count = wasCount;
                    const data = await resp.json();
                    window.dispatchEvent(new CustomEvent('notify', {
                        detail: { message: data.error === 'self_like_forbidden' ? 'Нельзя отметить свою запись' : (data.error || 'Ошибка'), type: 'error' }
                    }));
                } else {
                    const data = await resp.json();
                    this.count = data.like_count;
                }
            } catch (e) {
                this.liked = wasLiked;
                this.count = wasCount;
            }
        }
    }));
});

document.addEventListener('DOMContentLoaded', () => {
    updateCompareBar();
    if (!document.body.dataset.authenticated) {
        // Logged-out page: reset the per-session sync flag so the NEXT login
        // re-merges whatever the guest adds now (fixes "added then logged in, empty").
        sessionStorage.removeItem('tc_local_synced');
        updateWishlistBadge(getLocalWishlist().length);
    }
    document.body.addEventListener('compareUpdated', updateCompareBar);
    // Re-sync compare & wishlist badges after any HTMX content swap
    document.body.addEventListener('htmx:afterSettle', () => {
        updateCompareBar();
        if (!document.body.dataset.authenticated) {
            updateWishlistBadge(getLocalWishlist().length);
        }
    });
    document.querySelectorAll('.grind-dropdown').forEach(d => d.classList.remove('hidden'));

    // Bug 4: sticky header scroll class
    const header = document.getElementById('header');
    if (header) {
        const onScroll = () => {
            if (window.scrollY > 50) {
                header.classList.add('header-scrolled');
            } else {
                header.classList.remove('header-scrolled');
            }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        const logo = header.querySelector('.app-header-logo');
        if (logo) {
            logo.addEventListener('click', (e) => {
                if (window.location.pathname === '/' || window.location.pathname === '') {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }
    }

    // Bug 5: search autocomplete with debounce
    initSearchSuggest();

    // Bug 1: sync localStorage compare/wishlist/notes to DB on login
    syncLocalStorageOnLogin();
});

let _searchSuggestTimer = null;
function initSearchSuggest() {
    const inputs = document.querySelectorAll('input[name="q"]');
    inputs.forEach(input => {
        if (input.dataset.suggestBound) return;
        // Skip inputs managed by Alpine.js (they have their own suggestion logic)
        const alpineParent = input.closest('[x-data]');
        if (alpineParent && alpineParent.querySelector('[x-model="q"]')) {
            input.dataset.suggestBound = '1';
            return;
        }
        input.dataset.suggestBound = '1';

        const wrap = input.closest('form') || input.parentElement;
        if (!wrap) return;
        wrap.style.position = wrap.style.position || 'relative';
        const dropdown = document.createElement('div');
        dropdown.className = 'tc-search-suggest';
        dropdown.style.display = 'none';
        wrap.appendChild(dropdown);

        const closeDropdown = () => { dropdown.style.display = 'none'; };
        document.addEventListener('click', (e) => {
            if (!wrap.contains(e.target)) closeDropdown();
        });

        input.addEventListener('input', (e) => {
            const q = e.target.value.trim();
            clearTimeout(_searchSuggestTimer);
            if (q.length < 2) {
                closeDropdown();
                return;
            }
            _searchSuggestTimer = setTimeout(() => {
                fetch('/search/suggest/?q=' + encodeURIComponent(q), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data) return;
                    renderSearchSuggest(dropdown, data);
                })
                .catch(() => closeDropdown());
            }, 300);
        });

        input.addEventListener('focus', () => {
            if (input.value.trim().length >= 2 && dropdown.children.length) {
                dropdown.style.display = 'block';
            }
        });
    });
}

function renderSearchSuggest(dropdown, data) {
    const products = data.products || [];
    const posts = data.posts || [];
    const query = data.query || '';
    let html = '';

    if (products.length) {
        html += '<div class="tc-search-suggest__group"><div class="tc-search-suggest__title">Каталог</div>';
        for (const p of products) {
            const imgHtml = p.image
                ? `<img src="${escapeHtml(p.image)}" alt="" class="tc-search-suggest__img">`
                : `<div class="tc-search-suggest__img tc-search-suggest__img--placeholder"></div>`;
            const priceHtml = p.price
                ? `<span class="tc-search-suggest__price">${Number(p.price).toLocaleString('ru-RU')} \u20BD</span>`
                : '';
            html += `<a class="tc-search-suggest__item" href="${p.url}">${imgHtml}<span class="tc-search-suggest__info"><span class="tc-search-suggest__name">${escapeHtml(p.name)}</span>${p.category ? `<small class="tc-search-suggest__cat">${escapeHtml(p.category)}</small>` : ''}</span>${priceHtml}</a>`;
        }
        html += '</div>';
    }
    if (posts.length) {
        html += '<div class="tc-search-suggest__group"><div class="tc-search-suggest__title">Журнал</div>';
        for (const post of posts) {
            html += `<a class="tc-search-suggest__item" href="${post.url}"><span class="tc-search-suggest__info"><span class="tc-search-suggest__name">${escapeHtml(post.title)}</span></span></a>`;
        }
        html += '</div>';
    }
    if (!products.length && !posts.length) {
        html = '<div class="tc-search-suggest__empty">Ничего не найдено</div>';
    } else if (query) {
        html += `<a class="tc-search-suggest__view-all" href="/catalog/?q=${encodeURIComponent(query)}">Смотреть всё</a>`;
    }

    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
}

function escapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
}

function syncLocalStorageOnLogin() {
    if (!document.body.dataset.authenticated) return;
    // Use a per-session flag so we sync once per login session, not once ever.
    if (sessionStorage.getItem('tc_local_synced')) return;

    const compare = JSON.parse(localStorage.getItem('compare') || '[]');
    const notes = JSON.parse(localStorage.getItem('product_notes') || '{}');
    const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');

    const hasData = compare.length || Object.keys(notes).length || wishlist.length;

    if (!hasData) {
        sessionStorage.setItem('tc_local_synced', '1');
        return;
    }

    // Sync wishlist + notes to DB
    fetch('/account/sync-local/', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': getCookie('csrftoken'),
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ compare, notes, wishlist })
    }).then(r => r.ok ? r.json() : null).then(data => {
        if (data && data.ok) {
            // Keep the guest localStorage wishlist so favorites persist after
            // logout (the guest still sees them). Authenticated views never read
            // localStorage for wishlist (they use server-sourced inWishlist),
            // so keeping it is safe.
            sessionStorage.setItem('tc_local_synced', '1');
            // Refresh navbar counters live (no reload needed):
            if (typeof data.wishlist_count === 'number') {
                updateWishlistBadge(data.wishlist_count);
            }
            // Compare stays client-side — re-sync its badge from localStorage.
            updateCompareBar();
            // Notify product cards / Alpine components to re-read merged state.
            document.body.dispatchEvent(new CustomEvent('wishlistUpdated', { detail: { count: data.wishlist_count } }));
        }
    }).catch(() => {});
}

// 3.1 — bfcache: force reload when navigating back so Alpine re-initializes variants
window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
        window.location.reload();
    }
});

// Intercept clicks on wishlist links for guests to pass local IDs
document.addEventListener('click', function(e) {
    let link = e.target.closest('a');
    if (link) {
        const href = link.getAttribute('href');
        if (href === '/my-favorites' || href === '/my-favorites/' || href === '/account/wishlist/' || href === '/account/wishlist') {
            if (!document.body.dataset.authenticated) {
                e.preventDefault();
                const ids = getLocalWishlist().join(',');
                window.location.href = href + (ids ? '?ids=' + ids : '');
            }
        }
    }
});
