class PaymentWebhookThrottle(AnonRateThrottle):
    rate = "60/minute"


@method_decorator(csrf_exempt, name="dispatch")
class PaymentWebhookView(APIView):
    """
    YooKassa webhook endpoint.
    Idempotency: yookassa_id unique=True + select_for_update().
    Race condition fix: get_or_create instead of get — webhook may arrive
    before CreatePaymentView writes to DB.
    """
    permission_classes = [permissions.AllowAny]
    throttle_classes = [PaymentWebhookThrottle]

    def post(self, request):
        data = request.data
        if not data and request.body:
            try:
                data = json.loads(request.body)
            except (json.JSONDecodeError, UnicodeDecodeError):
                return Response({"detail": "Invalid JSON"}, status=status.HTTP_400_BAD_REQUEST)

        event = data.get("event", "")
        obj = data.get("object", {})
        payment_id = obj.get("id", "")
        payment_status_raw = obj.get("status", "")

        if not payment_id:
            return Response({"ok": True})  # Ignore malformed

        logger.info(f"YooKassa webhook: event={event} payment_id={payment_id} status={payment_status_raw}")

        try:
            return self._process_webhook(data, event, obj, payment_id, payment_status_raw)
        except Exception as e:
            logger.error(f"Webhook processing error: {e}")
            return Response({"detail": "Processing error"}, status=status.HTTP_400_BAD_REQUEST)

    def _process_webhook(self, data, event, obj, payment_id, payment_status_raw):
        with transaction.atomic():
            metadata = obj.get("metadata", {})
            order_id = metadata.get("order_id")

            payment, created = Payment.objects.select_for_update().get_or_create(
                yookassa_id=payment_id,
                defaults={
                    "status": Payment.STATUS_PENDING,
                    "amount": obj.get("amount", {}).get("value", 0),
                    "order_id": order_id,
                },
            )
            
            # If payment existed but wasn't linked to order yet, link it now
            if not created and not payment.order_id and order_id:
                payment.order_id = order_id
                payment.save(update_fields=["order_id"])


            if not created and payment.status == Payment.STATUS_SUCCEEDED:
                logger.info(f"Webhook {payment_id}: already succeeded, skipping")
                return Response({"ok": True})

            if event == "payment.succeeded" and payment_status_raw == "succeeded":
                payment.status = Payment.STATUS_SUCCEEDED
                payment.save(update_fields=["status", "updated_at"])

                if payment.order_id:
                    order = payment.order
                    order.payment_status = Order.PAYMENT_STATUS_PAID
                    order.status = Order.STATUS_PAID
                    order.save(update_fields=["payment_status", "status"])

                    from apps.orders.tasks import send_order_status_email, create_cdek_waybill
                    try:
                        send_order_status_email.delay(order.id, Order.STATUS_PAID)
                    except Exception as e:
                        logger.error(f"Failed to queue paid email for order {order.id}: {e}")

                    # Create CDEK waybill for CDEK delivery orders after payment
                    if order.delivery_type in (Order.DELIVERY_CDEK_PVZ, Order.DELIVERY_CDEK_DOOR):
                        try:
                            create_cdek_waybill.delay(order.id)
                        except Exception as e:
                            logger.error(f"Failed to queue CDEK waybill for order {order.id}: {e}")

                    logger.info(f"Order #{payment.order_id} marked as PAID via YooKassa webhook")

            elif event in ("payment.canceled", "payment.waiting_for_capture"):
                if event == "payment.canceled":
                    payment.status = Payment.STATUS_CANCELLED
                    payment.save(update_fields=["status", "updated_at"])

                    if payment.order_id:
                        order = payment.order
                        order.status = Order.STATUS_CANCELLED
                        order.save(update_fields=["status"])
                        logger.info(f"Order #{payment.order_id} CANCELLED via webhook")

        return Response({"ok": True})


class CreatePaymentView(APIView):
    """Create a YooKassa payment for an order."""
    permission_classes = [permissions.IsAuthenticated]

    def post(self, request):
        order_id = request.data.get("order_id")
        order = get_object_or_404(Order, id=order_id, user=request.user)

        if order.payment_status == Order.PAYMENT_STATUS_PAID:
            return Response(
                {"detail": "Заказ уже оплачен"},
                status=status.HTTP_400_BAD_REQUEST,
            )

        shop_id = getattr(settings, "YOOKASSA_SHOP_ID", "")
        secret_key = getattr(settings, "YOOKASSA_SECRET_KEY", "")
        if not shop_id or not secret_key:
            return Response(
                {"detail": "Платёжная система временно недоступна"},
                status=status.HTTP_503_SERVICE_UNAVAILABLE,
            )

        try:
            import yookassa
            yookassa.Configuration.account_id = shop_id
            yookassa.Configuration.secret_key = secret_key

            import uuid
            idempotency_key = str(uuid.uuid4())

            payment_data = yookassa.Payment.create({
                "amount": {
                    "value": str(order.total_amount),
                    "currency": "RUB",
                },
                "confirmation": {
                    "type": "redirect",
                    "return_url": request.build_absolute_uri(
                        f"/account/orders/{order.id}/payment/result/"
                    ),
                },
                "capture": True,
                "description": f"Заказ #{order.id} — Aspect Coffee",
                "metadata": {"order_id": str(order.id)},
            }, idempotency_key)

            payment, _ = Payment.objects.get_or_create(
                order=order,
                defaults={
                    "yookassa_id": payment_data.id,
                    "amount": order.total_amount,
                    "status": Payment.STATUS_PENDING,
                    "confirmation_url": payment_data.confirmation.confirmation_url,
                },
            )
            if payment.yookassa_id != payment_data.id:
                payment.yookassa_id = payment_data.id
                payment.confirmation_url = payment_data.confirmation.confirmation_url
                payment.save(update_fields=["yookassa_id", "confirmation_url"])

            from apps.payments.tasks import check_payment_timeout
            from apps.catalog.models import SiteSettings
            site_settings = SiteSettings.load()
            timeout_minutes = site_settings.payment_timeout_minutes or 10
            check_payment_timeout.apply_async(
                args=[payment.id],
                countdown=timeout_minutes * 60,
            )

            return Response({
                "payment_id": payment_data.id,
                "confirmation_url": payment_data.confirmation.confirmation_url,
            })

        except Exception as e:
            logger.error(f"YooKassa create payment error for order #{order_id}: {e}")
            return Response(
                {"detail": "Ошибка при создании платежа. Попробуйте позже."},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR,
            )


class InitiateRefundView(APIView):
    """Initiate YooKassa refund for an order (staff only)."""
    permission_classes = [permissions.IsAdminUser]

    def post(self, request, order_id):
        order = get_object_or_404(Order, id=order_id)

        if not hasattr(order, "payment") or order.payment.status != Payment.STATUS_SUCCEEDED:
            return Response(
                {"detail": "Нет успешного платежа для возврата"},
                status=status.HTTP_400_BAD_REQUEST,
            )

        from apps.payments.tasks import process_refund
        process_refund.delay(order.id)

        return Response({"detail": "Запрос на возврат принят в обработку"})
