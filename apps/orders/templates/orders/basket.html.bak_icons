{% extends "catalog/base.html" %}
{% load static %}
{% load socialaccount %}

{% block title %}Оформление заказа{% endblock %}
{# ═══ Standalone Edit Address Script (independent of Alpine x-data) ═══ #}
<script>
(function() {
    var _editAddrId = "";

    function tcGetCookie(name) {
        var v = document.cookie.split(";").map(function(c) { return c.trim(); });
        for (var i = 0; i < v.length; i++) {
            if (v[i].indexOf(name + "=") === 0) return decodeURIComponent(v[i].substring(name.length + 1));
        }
        return "";
    }

    window.openEditModal = function(id, label, city, street, house, apartment, postalCode, isDefault) {
        _editAddrId = id;
        var el;
        el = document.getElementById("edit-addr-label"); if(el) el.value = label || "";
        el = document.getElementById("edit-addr-city"); if(el) el.value = city || "";
        el = document.getElementById("edit-addr-street"); if(el) el.value = street || "";
        el = document.getElementById("edit-addr-house"); if(el) el.value = house || "";
        el = document.getElementById("edit-addr-apartment"); if(el) el.value = apartment || "";
        el = document.getElementById("edit-addr-postal"); if(el) el.value = postalCode || "";
        el = document.getElementById("edit-addr-default"); if(el) el.checked = !!isDefault;
        var modal = document.getElementById("edit-address-modal");
        if (modal) modal.style.display = "flex";
    };

    window.closeEditModal = function() {
        var modal = document.getElementById("edit-address-modal");
        if (modal) modal.style.display = "none";
        _editAddrId = "";
    };

    window.saveEditAddress = function() {
        if (!_editAddrId) return;
        var body = new URLSearchParams({
            label: (document.getElementById("edit-addr-label") || {}).value || "",
            city: (document.getElementById("edit-addr-city") || {}).value || "",
            street: (document.getElementById("edit-addr-street") || {}).value || "",
            house: (document.getElementById("edit-addr-house") || {}).value || "",
            apartment: (document.getElementById("edit-addr-apartment") || {}).value || "",
            postal_code: (document.getElementById("edit-addr-postal") || {}).value || "",
            is_default: (document.getElementById("edit-addr-default") || {}).checked ? "true" : "false"
        });
        fetch("/basket/address/" + _editAddrId + "/edit/", {
            method: "POST",
            headers: {
                "X-CSRFToken": tcGetCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest",
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: body
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.ok) window.location.reload();
        });
    };

    window.deleteAddress = function() {
        if (!confirm("\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0430\u0434\u0440\u0435\u0441?")) return;
        if (!_editAddrId) return;
        fetch("/basket/address/" + _editAddrId + "/delete/", {
            method: "POST",
            headers: {
                "X-CSRFToken": tcGetCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest"
            }
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.ok) window.location.reload();
        });
    };
})();
</script>

{% block content %}
<main>
<div class="container xl:pt-8 xl:mb-20">
        {% if cart and cart.items.all %}
        <div x-data="{
            deliveryType: 'courier',
            paymentMethod: 'card',
            selectedPvz: null,
            pvzSearch: '',
            cdekCityQuery: '',
            cdekCities: [],
            cdekSelectedCity: null,
            cdekOffices: [],
            cdekOfficeFilter: '',
            cdekDeliveryCost: null,
            cdekDeliveryDays: '',
            cdekLoading: false,
            cdekCityLoading: false,
            cdekCalcLoading: false,
            cartWeight: {{ total_weight|default:'500' }},
            _cityTimeout: null,
            async cdekSearchCities() {
                if (this.cdekCityQuery.length < 2) { this.cdekCities = []; return; }
                this.cdekCityLoading = true;
                try {
                    const r = await fetch('/api/cdek/cities/?q=' + encodeURIComponent(this.cdekCityQuery));
                    const d = await r.json();
                    this.cdekCities = d.cities || [];
                } catch(e) { this.cdekCities = []; }
                this.cdekCityLoading = false;
            },
            cdekCityInput() {
                clearTimeout(this._cityTimeout);
                this._cityTimeout = setTimeout(() => this.cdekSearchCities(), 350);
            },
            async cdekSelectCity(city) {
                this.cdekSelectedCity = city;
                this.cdekCityQuery = city.city + (city.region && city.region !== city.city ? ', ' + city.region : '');
                this.cdekCities = [];
                this.selectedPvz = null;
                this.cdekDeliveryCost = null;
                this.cdekOfficeFilter = '';
                if (this.deliveryType === 'cdek_pvz') {
                    await this.cdekLoadOffices();
                }
                await this.cdekCalcCost();
            },
            async cdekLoadOffices() {
                if (!this.cdekSelectedCity) return;
                this.cdekLoading = true;
                try {
                    const r = await fetch('/api/cdek/offices/?city_code=' + this.cdekSelectedCity.code);
                    const d = await r.json();
                    this.cdekOffices = d.offices || [];
                } catch(e) { this.cdekOffices = []; }
                this.cdekLoading = false;
            },
            async cdekCalcCost() {
                if (!this.cdekSelectedCity) return;
                this.cdekCalcLoading = true;
                try {
                    const r = await fetch('/api/cdek/calc/', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            city_code: this.cdekSelectedCity.code,
                            delivery_type: this.deliveryType,
                            weight: this.cartWeight
                        })
                    });
                    const d = await r.json();
                    if (d.cost !== undefined) {
                        this.cdekDeliveryCost = Math.round(d.cost);
                        this.cdekDeliveryDays = d.period_min === d.period_max ? d.period_min + ' дн.' : d.period_min + '–' + d.period_max + ' дн.';
                    } else {
                        this.cdekDeliveryCost = null;
                        this.cdekDeliveryDays = '';
                    }
                } catch(e) { this.cdekDeliveryCost = null; this.cdekDeliveryDays = ''; }
                this.cdekCalcLoading = false;
            },
            cdekSelectOffice(office) {
                this.selectedPvz = {code: office.code, address: office.address, name: office.name, work_time: office.work_time};
                this.$nextTick(() => this.checkValidation());
            },
            get cdekFilteredOffices() {
                if (!this.cdekOfficeFilter) return this.cdekOffices;
                const q = this.cdekOfficeFilter.toLowerCase();
                return this.cdekOffices.filter(o => (o.address || '').toLowerCase().includes(q) || (o.name || '').toLowerCase().includes(q));
            },
            selectAll: false,
            selectedItems: [],
            isOrg: false,
            isOtherRecipient: false,
            showRegister: false,
            regPassword: '',
            regPassword2: '',
            regPwdVisible: false,
            regPwd2Visible: false,
            showNewAddress: false,
                showEditModal: false,
                editAddress: {id: '', label: '', city: '', street: '', house: '', apartment: '', postal_code: '', is_default: false},
                hasAddresses: {% if addresses %}true{% else %}false{% endif %},
                openEditModal(id, label, city, street, house, apartment, postalCode, isDefault) {
                    this.editAddress = {id, label, city, street, house, apartment, postal_code: postalCode, is_default: isDefault};
                    this.showEditModal = true;
                },
                closeEditModal() { this.showEditModal = false; },
                saveEditAddress() {
                    fetch('/basket/address/' + this.editAddress.id + '/edit/', {
                        method: 'POST',
                        headers: {'X-CSRFToken': tcGetCookie('csrftoken'), 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded'},
                        body: new URLSearchParams({
                            label: this.editAddress.label,
                            city: this.editAddress.city,
                            street: this.editAddress.street,
                            house: this.editAddress.house,
                            apartment: this.editAddress.apartment,
                            postal_code: this.editAddress.postal_code,
                            is_default: this.editAddress.is_default
                        })
                    }).then(r => r.json()).then(d => { if(d.ok) window.location.reload(); });
                },
                deleteAddress() {
                    if (!confirm('Удалить адрес?')) return;
                    fetch('/basket/address/' + this.editAddress.id + '/delete/', {
                        method: 'POST',
                        headers: {'X-CSRFToken': tcGetCookie('csrftoken'), 'X-Requested-With': 'XMLHttpRequest'}
                    }).then(r => r.json()).then(d => { if(d.ok) window.location.reload(); });
                },
            agreeTerms: true,
            canSubmit: true,
            repeatOn: false,
            repeatWeeks: 1,
            selectedAddressId: '',
            phoneCode: '+7',
            phoneLength: 10,
            phoneCodeOpen: false,
            recipientPhoneCodeOpen: false,
            errors: { name: '', phone: '', email: '', address: '' },
            get phoneCodes() { return TCPhone.codes; },
            selectPhoneCode(code) {
                TCPhone.selectCode(code, this);
            },
            stripPhone() {
                TCPhone.stripInput(this, 'phone');
            },
            selectAddress(id, city, street, apartment) {
                this.selectedAddressId = id;
                this.showNewAddress = false;
                this.errors.address = '';
                document.querySelector('input[name=selected_address_id]') && (document.querySelector('input[name=selected_address_id]').value = id);
                const cityInputs = document.querySelectorAll('input[name=city], input[name=city_m]');
                const streetInputs = document.querySelectorAll('input[name=street], input[name=street_m]');
                const aptInputs = document.querySelectorAll('input[name=apartment], input[name=apt_m]');
                cityInputs.forEach(i => i.value = city);
                streetInputs.forEach(i => i.value = street);
                aptInputs.forEach(i => i.value = apartment);
            },
            items: [{% for item in cart.items.all %}'{{ item.variant.id }}'{% if not forloop.last %},{% endif %}{% endfor %}],
            getValue(names) {
                for (const name of names) {
                    const els = document.querySelectorAll(`input[name='${name}']`);
                    for (const el of els) {
                        if (el.offsetParent !== null) {
                            const v = el.value.trim();
                            if (v) return v;
                        }
                    }
                }
                for (const name of names) {
                    const v = document.querySelector(`input[name='${name}']`)?.value?.trim();
                    if (v) return v;
                }
                return '';
            },
            initCitySync() {
                const cityInputs = document.querySelectorAll('input[name=city], input[name=city_m]');
                cityInputs.forEach(input => {
                    input.addEventListener('input', (e) => {
                        const val = e.target.value.trim();
                        if (val.length >= 2 && (!this.cdekSelectedCity || this.cdekSelectedCity.city !== val)) {
                            this.cdekCityQuery = val;
                            this.cdekSearchCities().then(() => {
                                if (this.cdekCities.length > 0) {
                                    // Auto-select first matching city if it exactly matches or we are confident
                                    const exactMatch = this.cdekCities.find(c => c.city.toLowerCase() === val.toLowerCase());
                                    if (exactMatch) {
                                        this.cdekSelectCity(exactMatch);
                                    }
                                }
                            });
                        }
                    });
                });
            },
            checkValidation() {
                const e = { name: '', phone: '', email: '', address: '' };
                if (!this.agreeTerms) { this.canSubmit = false; this.errors = e; return; }
                if ({% if cart and cart.total_items %}{{ cart.total_items }}{% else %}0{% endif %} === 0) { this.canSubmit = false; this.errors = e; return; }
                const fullName = this.getValue(['full_name', 'full_name_m']);
                const phone = this.getValue(['phone', 'phone_m']);
                const email = this.getValue(['email', 'email_m']);
                const phoneDigits = phone.replace(/\D/g, '');
                const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
                let valid = true;
                if (!fullName) { e.name = 'Укажите имя и фамилию'; valid = false; }
                if (phoneDigits.length < this.phoneLength) { e.phone = 'Укажите полный номер телефона'; valid = false; }
                if (!emailValid) { e.email = 'Укажите корректный email'; valid = false; }
                if (this.deliveryType !== 'pickup') {
                    const hasSelectedAddr = this.selectedAddressId !== '' && this.selectedAddressId !== null;
                    const hasNewAddr = this.getValue(['city', 'city_m']) && this.getValue(['street', 'street_m']);
                    if (!hasSelectedAddr && !hasNewAddr) { e.address = 'Укажите адрес доставки'; valid = false; }
                }
                this.errors = e;
                this.canSubmit = valid;
            },
            showToast(msg, type) {
                const t = document.createElement('div');
                t.className = 'fixed top-6 left-1/2 -translate-x-1/2 z-[9999] px-6 py-3 rounded-xl text-sm font-bold shadow-lg transition-all duration-300 ' + (type === 'error' ? 'bg-red-600 text-white' : 'bg-green-600 text-white');
                t.textContent = msg;
                document.body.appendChild(t);
                setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3000);
            },
            handleSubmit(e) {
                if (e && e.preventDefault) e.preventDefault();
                this.checkValidation();
                if (!this.canSubmit) {
                    const msgs = [];
                    if (this.errors.name) msgs.push(this.errors.name);
                    if (this.errors.phone) msgs.push(this.errors.phone);
                    if (this.errors.email) msgs.push(this.errors.email);
                    if (this.errors.address) msgs.push(this.errors.address);
                    this.showToast(msgs.join('. '), 'error');
                    return;
                }
                const btn = document.querySelector('[data-checkout-submit]');
                if (btn) { btn.disabled = true; btn.textContent = 'Оформляем...'; }
                const fd = new FormData(document.getElementById('basket-form'));
                fd.set('action', 'checkout');
                fd.set('selected_address_id', this.selectedAddressId || '');
                fd.set('delivery_type', this.deliveryType);
                fd.set('payment_method', this.paymentMethod);
                fetch(window.location.pathname, { method: 'POST', body: fd, headers: {'X-Requested-With': 'XMLHttpRequest'} })
                    .then(r => r.text().then(text => {
                        let data;
                        try { data = JSON.parse(text); } catch(err) { data = null; }
                        if (data && data.redirect_url) {
                            window.location.href = data.redirect_url;
                        } else if (data && data.error) {
                            this.showToast(data.error, 'error');
                            if (btn) { btn.disabled = false; btn.textContent = 'Оформить заказ'; }
                        } else {
                            window.location.reload();
                        }
                    }))
                    .catch(() => {
                        this.showToast('Ошибка сети', 'error');
                        if (btn) { btn.disabled = false; btn.textContent = 'Оформить заказ'; }
                    });
            }
        }" x-init="initCitySync(); $nextTick(() => { stripPhone(); }); checkValidation(); setInterval(() => checkValidation(), 500); $watch('deliveryType', async (val) => { if ((val === 'cdek_pvz' || val === 'cdek_door') && this.cdekSelectedCity) { if (val === 'cdek_pvz' && this.cdekOffices.length === 0) await this.cdekLoadOffices(); await this.cdekCalcCost(); } else { this.cdekDeliveryCost = null; this.cdekDeliveryDays = ''; } })">
        <form @input.debounce.300ms="checkValidation()" @submit.prevent="" id="basket-form">
            {% csrf_token %}
            {% if messages %}
            <div class="mb-4 space-y-2">
                {% for msg in messages %}
                <div class="px-4 py-3 rounded-xl text-sm font-bold {% if msg.tags == 'error' %}bg-red-50 text-red-600 border border-red-200{% else %}bg-green-50 text-green-600 border border-green-200{% endif %}">
                    {{ msg }}
                </div>
                {% endfor %}
            </div>
            {% endif %}

            {# ═══ LEFT COLUMN ═══ #}
            <div id="basket-left-col">
                {# ── Cart Card ── #}
                <div class="bg-white rounded-2xl xl:rounded-3xl -mx-4 sm:mx-0 py-4 px-4 p-4 xl:p-6 flex flex-col !bg-[transparent] !p-0 !m-0">
<div class="min-w-[100%] flex items-center min-h-[38px] mb-3 py-1 border-b border-[var(--black-5)] xl:mb-0 md:py-0 xl:border-0 xl:min-h-[auto] xl:bg-white xl:rounded-t-3xl p-4 xl:order-2 xl:px-6 xl:pt-6 xl:pb-4 -mx-4 sm:mx-0 sm:px-0">
<h1 class="white-box__title mr-auto xl:mr-3.5">Корзина <span class="text-[var(--black-50)]" id="korzina-count">{{ cart.items.count }}</span></h1>
</div>

                    {# Timeline + Guarantee #}
                    {# Timeline + Guarantee #}
                    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:16px;">
<ul class="ti-list !items-center">
<li class="ti-list-item">
<svg class="h-[32px] w-[32px] min-w-[32px]"><use href="{% static 'asset/images/sprite.svg' %}#icons--fire"></use></svg>
<div class="ti-list__text medium"><p class="text-[var(--black-50)]">Соберём</p><p class="xs:text-nowrap">Сегодня</p></div>
</li>
<li class="ti-list-item">
<svg class="h-[32px] w-[32px] min-w-[32px]"><use href="{% static 'asset/images/sprite.svg' %}#icons--delivery"></use></svg>
<div class="ti-list__text medium"><p class="text-[var(--black-50)]">Отправим</p><p class="xs:text-nowrap">Завтра</p></div>
</li>
<li class="ti-list-item">
<svg class="h-[32px] w-[32px] min-w-[32px]"><use href="{% static 'asset/images/sprite.svg' %}#icons--pack"></use></svg>
<div class="ti-list__text medium"> <p class="text-[var(--black-50)]">Доставит</p>
<p x-text="deliveryType === 'courier' ? 'Курьер' : deliveryType === 'cdek_pvz' ? 'СДЭК ПВЗ' : deliveryType === 'cdek_door' ? 'СДЭК курьер' : 'Самовывоз'">Выберите способ</p>
<p x-show="deliveryType !== 'pickup'" x-text="deliveryType === 'courier' ? 'Завтра' : (cdekDeliveryDays || '2–5 дней')"></p>
<p class="xs:text-nowrap cursor-pointer" style="color:var(--blue);" x-show="deliveryType === 'pickup'">Выберите способ</p></div>
</li>
</ul>
<div class="tc-tooltip" style="flex:1;min-width:250px;">
<div class="tc-tooltip__btn h-full" style="border-bottom:none !important;">
<div class="button-basket medium text-black no-underline" style="border-bottom:none !important;">
<svg class="h-[32px] w-[32px] min-w-[32px] mr-2.5"><use href="{% static 'asset/images/sprite.svg' %}#icons--repeat"></use></svg>
                                    Если кофе не понравится, вернём деньги или заменим на другой
                                </div>
</div>
<div class="tc-tooltip__btn-slot"></div>
</div>
</div>

                    {# Cart Items #}
                    <ul class="bg-white -mx-4 sm:mx-0 max-sm:!w-auto p-4 xl:p-6 pb-0 xl:pb-[18px] xl:order-3 max-xl:rounded-t-2xl last:rounded-b-2xl xl:last:pb-6 w-full xl:space-y-9 space-y-5 flex-1 pb-0.5 -mb-0.5 empty:p-0 empty:!m-0">
                        {% for item in cart.items.all %}
                        <li data-variant-id="{{ item.variant.id }}" class="flex items-end flex-wrap xl:flex-nowrap max-xl:pb-5 max-xl:border-b border-[var(--black-4)] last:border-b-0 xl:py-1.5 max-xl:relative">
<div class="flex xl:items-center w-full xl:max-w-[46%] 2xl:max-w-[56%] mr-auto max-xl:order-1 max-xl:mb-6">
<a href="{{ item.variant.product.get_absolute_url }}">
                                    {% if item.variant.product.main_image %}
                                    <img alt="{{ item.variant.product.name }}" class="w-24 h-24 xl:w-20 xl:h-20 xl:-my-1.5 object-contain" src="{{ item.variant.product.main_image.url }}"/>
                                    {% else %}
                                    <div class="w-24 h-24 xl:w-20 xl:h-20 bg-[#f5f5f5] rounded-xl"></div>
                                    {% endif %}
                                </a>
<div class="space-y-2 pl-2 xl:pl-4 max-w-[calc(100%-96px)] xl:max-w-[calc(100%-80px)] w-full max-xl:flex max-xl:flex-col max-xl:pr-10 max-xl:pt-1">
<a class="text-[24px] text-black font-din-black uppercase leading-[1.2] tracking-[0.4px] m-0" href="{{ item.variant.product.get_absolute_url }}">{{ item.variant.product.name }}</a>
<div class="tc-tile__option -mb-2 max-xl:flex-wrap xl:space-x-2 flex !items-center basket-options">
<div class="flex items-center mr-1.5 whitespace-nowrap mb-2 options-measurable">
<div class="tc-weight active"><span class="tc-weight__text">{{ item.variant.weight }} г</span>{% if item.variant.discount_percent > 0 %}<sup class="tc-weight__sup">-{{ item.variant.discount_percent }}%</sup>{% endif %}</div>
</div>
<div class="flex items-center mr-1.5 whitespace-nowrap mb-2">
<div class="tc-weight active"><span class="tc-weight__text">{{ item.variant.get_grind_display }}</span></div>
</div>
</div>
</div>
</div>
<div class="flex items-center xs:space-x-2 xl:ml-4 max-xl:order-3 max-xl:mr-auto max-xl:relative">
<div class="tc-counter first:max-xl:ml-[104px] first:max-xs:ml-0">
<button class="tc-counter__btn" {% if item.qty > 1 %}onclick="tcUpdateCart({{ item.variant.id }}, {{ item.qty|add:'-1' }})"{% endif %} type="button"><svg height="50%" width="50%"><use href="{% static 'asset/images/sprite.svg' %}#icons--minus"></use></svg></button>
<div class="tc-counter__input"><span class="font-bold text-[15px] tc-counter__value">{{ item.qty }}</span></div>
<button class="tc-counter__btn" onclick="tcUpdateCart({{ item.variant.id }}, {{ item.qty|add:'1' }})" type="button"><svg height="50%" width="50%"><use href="{% static 'asset/images/sprite.svg' %}#icons--plus"></use></svg></button>
</div>
</div>
<div class="space-x-0.5 text-right xl:ml-4 w-[100px] max-xl:order-4">
                                {% if item.variant.old_price %}<div class="m-0 text-[18px] font-din-medium uppercase leading-[1.2] tracking-[0.05em] text-[var(--opacity-40)] line-through whitespace-nowrap"><div>{{ item.variant.old_price|floatformat:0 }}<span class="rub"> ₽</span></div></div>{% endif %}
                                <div class="m-0 text-[24px] font-din-black uppercase leading-[1.2] tracking-[0.4px] whitespace-nowrap"><div>{{ item.total_price|floatformat:0 }}<span class="rub"> ₽</span></div></div>
</div>
<button class="tc-btn btn-secondary-sm px-1 xl:ml-6 max-xl:!absolute max-xl:top-0 max-xl:right-0 !min-w-[32px]" onclick="tcRemoveFromCart({{ item.variant.id }})" type="button"><svg class="ic-right"><use href="{% static 'asset/images/sprite.svg' %}#icons--delete"></use></svg></button>
</li>
                        {% endfor %}
                    </ul>
</div>

                {# Comment #}
                <div class="white-box">
<p class="white-box__title">Комментарий</p>
<div class="tc-textarea secondary-textarea"><textarea class="resize-none overscroll-contain tc-textarea__field max-md:max-h-36" maxlength="300" name="comment" placeholder="Комментарий к заказу" style="height:44px;"></textarea></div>
</div>

                {# Recipient #}
                <div class="white-box xl:!space-y-6" id="contact-data">
<div class="flex items-center"><p class="white-box__title">Получатель</p></div>
                    {% if not user.is_authenticated %}
                    <div class="w-full space-y-2">
<p class="text-[14px] leading-[1.3] medium">Войти через:</p>
<ul class="list-none p-0 m-0 flex flex-wrap overflow-auto items-center gap-2">
<li><a class="block cursor-pointer" href="{% provider_login_url 'yandex' %}"><svg class="text-[var(--black-4)] h-11 w-11"><use href="{% static 'images/sprite.svg' %}#service--yandex-colored"></use></svg></a></li>
<li><a class="block cursor-pointer" href="{% provider_login_url 'vk' %}"><svg class="text-[var(--black-4)] h-11 w-11"><use href="{% static 'images/sprite.svg' %}#service--vk-blue"></use></svg></a></li>
<li><a class="block cursor-pointer" href="#" onclick="event.preventDefault();document.getElementById('login-modal-overlay').style.display='flex'"><svg class="text-[var(--black-4)] h-11 w-11"><use href="{% static 'images/sprite.svg' %}#service--email"></use></svg></a></li>
</ul>
</div>
                    {% endif %}
                    {# Desktop #}
                    <div class="recipient-desktop">
<div class="grid grid-cols-12 2xl:grid-cols-[repeat(15,minmax(0,1fr))] gap-x-2 gap-y-4 mb-4 xl:mb-6">
<div class="col-span-12 2xl:col-span-6">
<div class="tc-input"><label class="tc-input__label">Имя и фамилия</label><div class="tc-input__field"><input :class="errors.name && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" autocomplete="off" class="tc-input__field--input" name="full_name" type="text" value="{{ user.first_name|default:'' }} {{ user.last_name|default:'' }}"/></div></div>
<template x-if="errors.name"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.name"></p></template>
</div>
<div class="col-span-12 xl:col-span-6 2xl:col-span-4">
<div class="tc-phone">
<label class="tc-phone__label">Телефон</label>
<div class="relative"><div class="tc-phone__field">
<div @click.outside="phoneCodeOpen = false" class="tc-select phone-select flex-1"><div class="tc-select__field"><div @click="phoneCodeOpen = !phoneCodeOpen" class="tc-select__field--select cursor-pointer"><span class="select-text" x-text="phoneCode">+7</span><span class="tc-select__field--arr"></span></div></div>
<div class="absolute left-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-gray-100 w-[220px] max-h-[240px] overflow-y-auto z-50 py-1" x-cloak="" x-show="phoneCodeOpen" x-transition="">
<template :key="c.code" x-for="c in phoneCodes">
<button :class="phoneCode === c.code ? 'bg-gray-100 font-bold' : ''" @click="selectPhoneCode(c.code)" class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center gap-2" type="button">
<span class="font-mono text-gray-500 w-10" x-text="c.code"></span>
<span x-text="c.country"></span>
</button>
</template>
</div>
</div>
<input :value="phoneCode" name="phone_code" type="hidden"/>
<div class="tc-input" inputmode="tel"><div class="tc-input__field"><input :class="errors.phone && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" autocomplete="tel" class="tc-input__field--input" inputmode="tel" name="phone" oninput="tcPhoneMask(event)" placeholder="(000) 000-00-00" type="tel" value="{{ user.phone|default:'' }}" x-bind:data-phone-length="phoneLength" x-bind:maxlength="phoneLength + 6"/></div></div>
</div></div>
<template x-if="errors.phone"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.phone"></p></template>
</div>
</div>
<div class="col-span-12 xl:col-span-6 2xl:col-span-5">
<div class="tc-input"><label class="tc-input__label">Электронная почта</label><div class="tc-input__field"><input :class="errors.email && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" class="tc-input__field--input" name="email" type="email" value="{{ user.email|default:'' }}"/></div></div>
<template x-if="errors.email"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.email"></p></template>
</div>
</div>
<div class="w-full">
                            {% if not user.is_authenticated %}
                            <div class="border-t border-[var(--black-4)] py-4 xl:p-6 xl:-mx-6 last:pb-0 space-y-4">
<label class="tc-checkbox cursor-pointer"><input class="tc-checkbox__input cursor-pointer" name="register_account" type="checkbox" x-model="showRegister"/><span class="tc-checkbox__text"><span>Зарегистрироваться</span></span></label>
<div class="space-y-3 pt-3" x-show="showRegister" x-transition="">
<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
<div class="tc-input" x-data="{ showPwd: false }">
<div class="tc-input__field">
<input :type="showPwd ? 'text' : 'password'" @input="checkValidation()" class="pr-10 tc-input__field--input w-full" name="reg_password" placeholder="Новый пароль" x-model="regPassword"/>
<button @click="showPwd = !showPwd" class="tc-input__field--btn-right" type="button">
<svg class="w-6 h-6" x-show="!showPwd"><use href="{% static 'images/sprite.svg' %}#icons--viewing-close"></use></svg>
<svg class="w-6 h-6" x-cloak="" x-show="showPwd"><use href="{% static 'images/sprite.svg' %}#icons--viewing-stroke"></use></svg>
</button>
</div>
<template x-if="regPassword && regPassword.length < 6"><p class="text-red-500 text-xs mt-1 px-1">Минимум 6 символов</p></template>
</div>
<div class="tc-input" x-data="{ showPwd2: false }">
<div class="tc-input__field">
<input :type="showPwd2 ? 'text' : 'password'" @input="checkValidation()" class="pr-10 tc-input__field--input w-full" name="reg_password2" placeholder="Повторить" x-model="regPassword2"/>
<button @click="showPwd2 = !showPwd2" class="tc-input__field--btn-right" type="button">
<svg class="w-6 h-6" x-show="!showPwd2"><use href="{% static 'images/sprite.svg' %}#icons--viewing-close"></use></svg>
<svg class="w-6 h-6" x-cloak="" x-show="showPwd2"><use href="{% static 'images/sprite.svg' %}#icons--viewing-stroke"></use></svg>
</button>
</div>
<template x-if="regPassword2 && regPassword !== regPassword2"><p class="text-red-500 text-xs mt-1 px-1">Пароли не совпадают</p></template>
</div>
</div>
</div>
</div>
                            {% endif %}
                            <div class="border-t border-[var(--black-4)] py-4 xl:p-6 xl:-mx-6 last:pb-0 space-y-4">
<label class="tc-checkbox cursor-pointer"><input class="tc-checkbox__input cursor-pointer" name="is_organization" type="checkbox" x-model="isOrg"/><span class="tc-checkbox__text">Заказ на организацию</span></label>
<div class="space-y-3 pt-3" x-show="isOrg" x-transition=""><input class="tc-input__field--input w-full" name="org_name" placeholder="Название организации" type="text"/><input class="tc-input__field--input w-full" maxlength="12" name="org_inn" oninput="this.value=this.value.replace(/\D/g,'').slice(0,12)" placeholder="ИНН" type="text"/></div>
</div>
<div class="border-t border-[var(--black-4)] py-4 xl:p-6 xl:-mx-6 last:pb-0 space-y-4">
<label class="tc-checkbox cursor-pointer"><input class="tc-checkbox__input cursor-pointer" name="other_recipient" type="checkbox" x-model="isOtherRecipient"/><span class="tc-checkbox__text">Другой получатель</span></label>
<div class="space-y-3 pt-3" x-show="isOtherRecipient" x-transition=""><input class="tc-input__field--input w-full" name="recipient_name" placeholder="Имя и фамилия получателя" type="text"/>
<div class="relative"><div class="tc-phone__field">
<div @click.outside="recipientPhoneCodeOpen = false" class="tc-select phone-select flex-1"><div class="tc-select__field"><div @click="recipientPhoneCodeOpen = !recipientPhoneCodeOpen" class="tc-select__field--select cursor-pointer"><span class="select-text" x-text="phoneCode">+7</span><span class="tc-select__field--arr"></span></div></div>
<div class="absolute left-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-gray-100 w-[220px] max-h-[240px] overflow-y-auto z-50 py-1" x-cloak="" x-show="recipientPhoneCodeOpen" x-transition="">
<template :key="c.code" x-for="c in phoneCodes">
<button :class="phoneCode === c.code ? 'bg-gray-100 font-bold' : ''" @click="selectPhoneCode(c.code)" class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center gap-2" type="button">
<span class="font-mono text-gray-500 w-10" x-text="c.code"></span>
<span x-text="c.country"></span>
</button>
</template>
</div>
</div>
<input :value="phoneCode" name="recipient_phone_code" type="hidden"/>
<div class="tc-input" inputmode="tel"><div class="tc-input__field"><input autocomplete="tel" class="tc-input__field--input" inputmode="tel" name="recipient_phone" oninput="tcPhoneMask(event)" placeholder="(000) 000-00-00" type="tel" x-bind:data-phone-length="phoneLength" x-bind:maxlength="phoneLength + 6"/></div></div>
</div></div>
</div>
</div>
</div>
</div>
                    {# Mobile #}
                    <div class="recipient-mobile space-y-1">
<input :class="errors.name && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" class="tc-input__field--input w-full" name="full_name_m" placeholder="Имя и фамилия" type="text" value="{{ user.first_name|default:'' }} {{ user.last_name|default:'' }}"/>
<template x-if="errors.name"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.name"></p></template>
<input :class="errors.phone && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" class="tc-input__field--input w-full" name="phone_m" oninput="tcPhoneMask(event)" placeholder="Телефон" type="tel" value="{{ user.phone|default:'' }}" x-bind:data-phone-length="phoneLength" x-bind:maxlength="phoneLength + 6"/>
<template x-if="errors.phone"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.phone"></p></template>
<input :class="errors.email && 'border-red-500'" @change="checkValidation()" @input="checkValidation()" class="tc-input__field--input w-full" name="email_m" placeholder="Email" type="email" value="{{ user.email|default:'' }}"/>
<template x-if="errors.email"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.email"></p></template>
</div>
<input :value="deliveryType" name="delivery_type" type="hidden"/>
<input :value="paymentMethod" name="payment_method" type="hidden"/>
<input name="selected_address_id" type="hidden" value=""/>
</div>

                {# Delivery #}
                <div class="white-box xl:!space-y-6" id="delivery-data">
<div class="flex items-center"><p class="white-box__title">Доставка</p></div>
<div class="delivery-desktop w-full" x-show="deliveryType !== 'pickup'" x-transition="">
<div class="w-full xl:space-y-3">
<p class="xl:bold max-xl:text-[24px] max-xl:font-din-black max-xl:uppercase max-xl:leading-[1.2] xl:text-[18px]">Адрес</p>
<ul class="list-none grid grid-cols-1 xl:grid-cols-3 xl:gap-2">
                                <li class="group relative max-xl:py-4 max-xl:border-b max-xl:border-[var(--black-4)]">
<button @click="showNewAddress = !showNewAddress; selectedAddressId = null; document.querySelector('input[name=selected_address_id]') && (document.querySelector('input[name=selected_address_id]').value = '')" class="tc-btn-card min-h-full basket-view-xl" type="button"><svg class="tc-btn-card__ic"><use href="{% static 'asset/images/sprite.svg' %}#icons--plus"></use></svg><span class="tc-btn-card__text bold"><span class="mr-1 last:ml-0">Новый адрес</span></span></button>
</li>
                                {% for address in addresses %}
                                <li class="group relative">
<label class="tc-checkbox-card h-full basket-view-xl">
<span class="flex items-center !mb-auto"><input id="address-{{ address.id }}" type="radio" name="address_id" class="tc-checkbox-card__input !mb-auto not-header-title" value="{{ address.id }}" @click="selectAddress('{{ address.id }}', '{{ address.city|escapejs }}', '{{ address.street|escapejs }}', '{{ address.apartment|escapejs }}')"/><span class="tc-checkbox-card__header-title bold">{% if address.label %}{{ address.label }}{% endif %}</span></span>
<span class="tc-checkbox-card__text max-xl:pr-12">{{ address.city }}{% if address.postal_code %}, {{ address.postal_code }}{% endif %}</span>
<span class="border-checked !m-0"></span>
</label>
<div class="button-edit-address" onclick="openEditModal('{{ address.id }}', '{{ address.label|escapejs }}', '{{ address.city|escapejs }}', '{{ address.street|escapejs }}', '{{ address.house|escapejs }}', '{{ address.apartment|escapejs }}', '{{ address.postal_code|escapejs }}', {{ address.is_default|yesno:"true,false" }})"><svg class="w-6 h-6"><use href="{% static 'asset/images/sprite.svg' %}#icons--edit"></use></svg></div>
</li>
                                {% endfor %}
</ul>
<template x-if="errors.address"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.address"></p></template>
<div class="mt-4 grid grid-cols-2 xl:grid-cols-3 md:grid-cols-5 xl:gap-2" x-show="showNewAddress || !hasAddresses" x-transition="">
<input class="tc-input__field--input w-full" name="postal_code" placeholder="Индекс" type="text" maxlength="6" oninput="this.value=this.value.replace(/[^0-9]/g,'').substring(0,6)"/>
<input class="tc-input__field--input w-full" name="city" placeholder="Город" type="text"/>
<input class="tc-input__field--input w-full" name="street" placeholder="Улица" type="text"/>
<input class="tc-input__field--input w-full" name="house" placeholder="Дом" type="text"/>
<input class="tc-input__field--input w-full" name="apartment" placeholder="Квартира / Офис" type="text"/>
</div>
<div class="mt-2" x-show="showNewAddress || !hasAddresses" x-transition="">
<label class="tc-checkbox cursor-pointer"><input class="tc-checkbox__input cursor-pointer" name="is_address_main" type="checkbox" checked/><span class="tc-checkbox__text">Сделать основным адресом</span></label>
</div>
</div>
</div>
<div class="delivery-mobile space-y-3" x-show="deliveryType !== 'pickup'" x-transition="">
                        {% if addresses %}
                        <div class="flex flex-col gap-2 mb-3">
                            {% for address in addresses %}
                            <button :class="selectedAddressId === '{{ address.id }}' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5'" @click="selectAddress('{{ address.id }}', '{{ address.city|escapejs }}', '{{ address.street|escapejs }}', '{{ address.apartment|escapejs }}')" class="w-full text-left p-4 rounded-2xl border-2 transition-all" type="button">
<div class="flex items-center justify-between">
<div>
<p class="font-bold text-sm mb-0.5">{% if address.label %}{{ address.label }}{% else %}Адрес{% endif %}</p>
<p class="text-xs text-black/50">{{ address.city }}, {{ address.street }}{% if address.house %}, д. {{ address.house }}{% endif %}{% if address.apartment %}, {{ address.apartment }}{% endif %}{% if address.postal_code %}, {{ address.postal_code }}{% endif %}</p>
{% if address.is_default %}<span class="text-[10px] font-bold bg-black text-white px-2 py-0.5 rounded-full mt-1.5 inline-block">Основной</span>{% endif %}
</div>
<div class="w-6 h-6 bg-black rounded-full flex items-center justify-center flex-shrink-0" x-cloak="" x-show="selectedAddressId === '{{ address.id }}'"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path></svg></div>
</div>
</button>
                            {% endfor %}
                            {% if addresses %}<button :class="showNewAddress ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5'" @click="showNewAddress = !showNewAddress; if(showNewAddress) { selectedAddressId = null; document.querySelector('input[name=selected_address_id]') && (document.querySelector('input[name=selected_address_id]').value = ''); }" class="w-full text-left p-4 rounded-2xl border-2 transition-all" type="button">
<span class="font-bold text-sm">+ Новый адрес</span>
</button>{% endif %}
</div>
<div class="space-y-3" x-show="showNewAddress || !selectedAddressId || !hasAddresses" x-transition="">
                        {% endif %}
                            <input class="tc-input__field--input w-full" name="postal_code_m" placeholder="Индекс" type="text" maxlength="6" oninput="this.value=this.value.replace(/[^0-9]/g,'').substring(0,6)"/>
<input class="tc-input__field--input w-full" name="city_m" placeholder="Город" type="text"/>
<input class="tc-input__field--input w-full" name="street_m" placeholder="Улица" type="text"/>
<input class="tc-input__field--input w-full" name="house_m" placeholder="Дом" type="text"/>
<input class="tc-input__field--input w-full" name="apt_m" placeholder="Квартира / Офис" type="text"/>
<label class="tc-checkbox cursor-pointer"><input class="tc-checkbox__input cursor-pointer" name="is_address_main" type="checkbox" checked/><span class="tc-checkbox__text">Сделать основным адресом</span></label>
                        {% if addresses %}
                        </div>
                        {% endif %}
                        <template x-if="errors.address"><p class="text-red-500 text-xs mt-1 px-1" x-text="errors.address"></p></template>
</div>
<div class="w-full border-t border-[var(--black-4)] pt-6 mt-6">
<p class="xl:bold max-xl:text-[24px] max-xl:font-din-black max-xl:uppercase max-xl:leading-[1.2] xl:text-[18px] mb-4">Способ доставки</p>
<div class="grid grid-cols-1 md:grid-cols-1 md:grid-cols-2 gap-3">
<label :class="deliveryType === 'courier' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex items-center gap-4 p-5 rounded-2xl border-2 transition-all cursor-pointer"><input class="w-5 h-5 accent-black" name="delivery_type_radio" type="radio" value="courier" x-model="deliveryType"/><div class="leading-tight"><p class="font-bold text-sm text-black">Курьер по городу</p><p class="text-[12px] text-black/55">До двери, в удобное время</p></div></label>
<label :class="deliveryType === 'cdek_pvz' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex items-center gap-4 p-5 rounded-2xl border-2 transition-all cursor-pointer"><input class="w-5 h-5 accent-black" name="delivery_type_radio" type="radio" value="cdek_pvz" x-model="deliveryType"/><div class="leading-tight"><p class="font-bold text-sm text-black">СДЭК — до пункта выдачи</p><p class="text-[12px] text-black/55">Более 3000 пунктов по всей России</p></div></label>
<label :class="deliveryType === 'cdek_door' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex items-center gap-4 p-5 rounded-2xl border-2 transition-all cursor-pointer"><input class="w-5 h-5 accent-black" name="delivery_type_radio" type="radio" value="cdek_door" x-model="deliveryType"/><div class="leading-tight"><p class="font-bold text-sm text-black">СДЭК — курьером до двери</p><p class="text-[12px] text-black/55">Доставка до двери курьером СДЭК</p></div></label>
<label :class="deliveryType === 'pickup' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex items-center gap-4 p-5 rounded-2xl border-2 transition-all cursor-pointer"><input class="w-5 h-5 accent-black" name="delivery_type_radio" type="radio" value="pickup" x-model="deliveryType"/><div class="leading-tight"><p class="font-bold text-sm text-black">Самовывоз</p><p class="text-[12px] text-black/55">Ижевск, ул. Баранова, д. 26</p></div></label>
</div>
</div>
                    {# ── CDEK City Search (shown for both cdek_pvz and cdek_door) ── #}
                    <div class="mt-6 w-full" x-show="deliveryType === 'cdek_pvz' || deliveryType === 'cdek_door'" x-transition="">
<div class="p-6 rounded-3xl bg-gray-50 border border-gray-100">
<h3 class="font-bold text-base mb-3 text-black">Город доставки СДЭК</h3>
<div class="relative mb-1">
<input @focus="if(cdekCityQuery.length>=2) cdekSearchCities()" @input="cdekCityInput()" autocomplete="off" class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none focus:border-black bg-white text-black" placeholder="Начните вводить город..." type="text" x-model="cdekCityQuery"/>
<div class="absolute right-3 top-1/2 -translate-y-1/2" x-show="cdekCityLoading">
<svg class="animate-spin h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg>
</div>
                                {# City dropdown #}
                                <div @click.outside="cdekCities = []" class="absolute z-50 left-0 right-0 top-full mt-1 bg-white rounded-2xl shadow-xl border border-gray-100 max-h-[240px] overflow-y-auto" x-show="cdekCities.length > 0" x-transition="">
<template :key="city.code" x-for="city in cdekCities">
<button @click="cdekSelectCity(city)" class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-0" type="button">
<span class="font-bold text-sm text-black" x-text="city.city"></span>
<span class="text-xs text-black/40 ml-1" x-text="city.region && city.region !== city.city ? city.region : ''"></span>
</button>
</template>
</div>
</div>
                            {# Selected city + cost display #}
                            <div class="mt-3" x-show="cdekSelectedCity">
<div class="flex items-center gap-3 flex-wrap">
<div class="flex items-center gap-2 bg-white rounded-xl px-3 py-2 border border-black/10">
<svg class="w-4 h-4 text-green-600 shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
<span class="text-sm font-bold text-black" x-text="cdekSelectedCity ? cdekSelectedCity.city : ''"></span>
</div>
<div class="flex items-center gap-2 text-sm text-black/40" x-show="cdekCalcLoading">
<svg class="animate-spin h-4 w-4" fill="none" viewbox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg>
                                        Расчёт...
                                    </div>
<div class="flex items-center gap-3" x-show="cdekDeliveryCost !== null && !cdekCalcLoading">
<span class="text-sm font-bold text-black" x-text="cdekDeliveryCost + ' ₽'"></span>
<span class="text-xs text-black/50" x-text="cdekDeliveryDays"></span>
</div>
</div>
</div>
</div>
</div>

                    {# ── PVZ Picker (only for cdek_pvz) ── #}
                    <div class="mt-4 p-6 rounded-3xl bg-gray-50 border border-gray-100 w-full" x-show="deliveryType === 'cdek_pvz' && cdekSelectedCity" x-transition="">
<h3 class="font-bold text-base mb-3 text-black">Выберите пункт выдачи</h3>
<div class="flex items-center justify-center py-10" x-show="cdekLoading">
<svg class="animate-spin h-8 w-8 text-black/20" fill="none" viewbox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg>
</div>
<div x-show="!cdekLoading">
<input class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none focus:border-black bg-white text-black mb-3 text-sm" placeholder="Поиск по адресу..." type="text" x-model="cdekOfficeFilter"/>
<div class="text-center py-6 text-black/40 text-sm" x-show="cdekOffices.length === 0 && !cdekLoading">
                                Нет пунктов выдачи в выбранном городе
                            </div>
<div class="overflow-y-auto space-y-2 max-h-[350px] cdek-pvz-scroll" x-show="cdekFilteredOffices.length > 0">
<template :key="office.code" x-for="office in cdekFilteredOffices">
<div :class="selectedPvz && selectedPvz.code === office.code ? 'border-black bg-white shadow-sm' : 'border-transparent bg-white/60'" @click="cdekSelectOffice(office)" class="p-4 rounded-xl border-2 cursor-pointer transition-all hover:bg-white">
<div class="flex items-start justify-between gap-2">
<div class="flex-1 min-w-0">
<p class="font-bold text-sm mb-1 text-black truncate" x-text="office.name || office.code"></p>
<p class="text-[12px] text-black/60 leading-relaxed" x-text="office.address"></p>
<p class="text-[11px] text-black/40 mt-1" x-text="office.work_time"></p>
</div>
<div class="w-6 h-6 bg-black rounded-full flex items-center justify-center shrink-0 mt-0.5" x-show="selectedPvz && selectedPvz.code === office.code">
<svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path></svg>
</div>
</div>
</div>
</template>
</div>
<p class="text-[11px] text-black/30 mt-2 text-center" x-show="cdekFilteredOffices.length > 0" x-text="'Найдено пунктов: ' + cdekFilteredOffices.length"></p>
</div>
<input :value="selectedPvz ? selectedPvz.code : ''" name="cdek_pvz_code" type="hidden"/>
<input :value="selectedPvz ? selectedPvz.address : ''" name="cdek_pvz_address" type="hidden"/>
                        {# Selected PVZ confirmation #}
                        <div class="mt-4 p-4 rounded-2xl bg-white border border-black/10 flex items-center gap-4" x-show="selectedPvz">
<div class="w-10 h-10 rounded-full bg-green-50 text-green-600 flex items-center justify-center shrink-0"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg></div>
<div class="leading-tight min-w-0"><p class="text-xs text-black/40 mb-0.5">Выбранный пункт:</p><p class="font-bold text-sm text-black" x-text="selectedPvz ? selectedPvz.address : ''"></p><p class="text-xs text-black/40 mt-0.5" x-text="selectedPvz ? selectedPvz.work_time : ''"></p></div>
</div>
</div>

                    {# Hidden input for delivery cost #}
                    <input :value="cdekDeliveryCost || ''" name="cdek_delivery_cost" type="hidden"/>
<input :value="cdekSelectedCity ? cdekSelectedCity.code : ''" name="cdek_city_code" type="hidden"/>
<input :value="cdekSelectedCity ? cdekSelectedCity.city : ''" name="cdek_city_name" type="hidden"/>
</div>

                {# Payment #}
                <div class="white-box xl:!space-y-6" id="payment-data">
<div class="flex items-center"><p class="white-box__title">Способ оплаты</p></div>
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                        {% if user.is_authenticated and user.balance > 0 %}
                        <label :class="paymentMethod === 'internal' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex flex-col items-center justify-center gap-3 p-5 rounded-2xl border-2 transition-all cursor-pointer text-center">
<input class="sr-only" name="payment_method_radio" type="radio" value="internal" x-model="paymentMethod"/>
<div class="w-10 h-10 bg-black/5 rounded-xl flex items-center justify-center">
<svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewbox="0 0 24 24">
<path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<span class="font-bold text-sm text-black">Внутренний счет</span>
<span class="text-[10px] text-gray-500 mt-[-8px]">Баланс: {{ user.balance }} ₽</span>
</label>
                        {% endif %}
                        <label :class="paymentMethod === 'card' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex flex-col items-center justify-center gap-3 p-5 rounded-2xl border-2 transition-all cursor-pointer text-center"><input class="sr-only" name="payment_method_radio" type="radio" value="card" x-model="paymentMethod"/><div class="w-10 h-10 bg-black/5 rounded-xl flex items-center justify-center"><svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div><span class="font-bold text-sm text-black">Картой на сайте</span></label>
<label :class="paymentMethod === 'sbp' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex flex-col items-center justify-center gap-3 p-5 rounded-2xl border-2 transition-all cursor-pointer text-center"><input class="sr-only" name="payment_method_radio" type="radio" value="sbp" x-model="paymentMethod"/><div class="w-10 h-10 bg-black/5 rounded-xl flex items-center justify-center"><svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div><span class="font-bold text-sm text-black">СБП (QR-код)</span></label>
<label :class="paymentMethod === 'cod' ? 'border-black bg-white shadow-md' : 'border-black/5 bg-black/5 hover:border-black/10'" class="relative flex flex-col items-center justify-center gap-3 p-5 rounded-2xl border-2 transition-all cursor-pointer text-center"><input class="sr-only" name="payment_method_radio" type="radio" value="cod" x-model="paymentMethod"/><div class="w-10 h-10 bg-black/5 rounded-xl flex items-center justify-center"><svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div><span class="font-bold text-sm text-black">При получении</span></label>

                        
    
                        
    </div>
</div>
</div>

            {# ═══ RIGHT COLUMN (SIDEBAR) ═══ #}
            <div id="basket-sidebar">
<div class="checkout-card">
<div class="notice">Осталось указать <span>контактные данные</span></div>
<div class="total-row">
<div class="total-label">К оплате</div>
<div class="total-price" id="checkout-total-price">{{ cart.total|floatformat:0 }} ₽</div>
</div>
<div class="price-details">
<div class="price-row"><div>Товары</div><div class="dots"></div><div id="checkout-items-price">{{ cart.subtotal|floatformat:0 }} ₽</div></div>
<div class="price-row"><div>Доставка</div><div class="dots"></div><div x-text="cdekDeliveryCost !== null ? cdekDeliveryCost + ' ₽' : deliveryType === 'pickup' ? 'бесплатно' : 'рассчитается'"></div></div>
                        {% if cart.discount_amount > 0 %}
                        <div class="price-row"><div>Промокод</div><div class="dots"></div><div>−{{ cart.discount_amount|floatformat:0 }} ₽</div></div>
                        {% endif %}
                    </div>
<div class="input-group">
                        {% if cart.promo_code %}
                        <div class="input-field"><input readonly="" type="text" value="{{ cart.promo_code.code }}"/><a class="action-btn" href="{% url 'orders:basket' %}?remove_promo=1">Сбросить</a></div>
                        {% else %}
                        <div class="input-field">
<input id="promo-input" name="code" placeholder="Промокод" type="text"/>
<button class="action-btn" onclick="document.getElementById('promo-form-input').value=document.getElementById('promo-input').value;document.getElementById('promo-form').submit();" style="color:#fff;" type="button">Применить</button>
</div>
                        {% endif %}
                        <div class="input-field"><input name="gift_code" placeholder="Подарочный сертификат" type="text"/></div>
</div>
<div class="info-section"><div class="info-text">Оплата IQMoney, Mir Pay</div></div>
<button :class="{ 'opacity-40 cursor-not-allowed': !canSubmit }" :disabled="!canSubmit" @click="handleSubmit($event)" class="submit-btn" data-checkout-submit="true" name="action" type="button" value="checkout">Оформить заказ</button>
<label class="terms-container">
<input name="agree_terms" type="checkbox" x-model="agreeTerms"/>
<div class="custom-checkbox"></div>
<span class="terms-text">Согласен с <a href="{% url 'pages:privacy' %}" style="color:#888;border-bottom:1px dotted #666;" target="_blank">условиями обработки данных</a>, <a href="{% url 'pages:user_agreement' %}" style="color:#888;border-bottom:1px dotted #666;" target="_blank">пользовательского соглашения</a> и <a href="{% url 'pages:public_offer' %}" style="color:#888;border-bottom:1px dotted #666;" target="_blank">оферты</a></span>
</label>
</div>
<div class="white-box bg-white rounded-3xl border border-[#ebebeb] p-5">
<label class="flex items-center gap-2 cursor-pointer mb-2"><input class="accent-black w-4 h-4" type="checkbox" x-model="repeatOn"/><span class="text-[13px] font-bold uppercase tracking-wider text-black/50">Повторить заказ</span></label>
<div x-show="repeatOn">
<div class="flex items-center gap-2 text-[14px] mb-2"><span>каждую</span><input class="w-12 text-center bg-[#f5f5f5] border-0 rounded-lg px-2 py-1.5 font-bold focus:outline-none" max="12" min="1" type="number" x-model="repeatWeeks"/><span>неделю</span></div>
<p class="text-[12px] text-black/40 leading-[1.4]" x-text="'Мы будем отправлять вам такие заказы раз в ' + (repeatWeeks * 7) + ' дней.'"></p>
</div>
</div>
</div>
</form>
        {% else %}
        <div class="text-center py-20">
<div class="w-[90px] h-[90px] bg-white rounded-full flex items-center justify-center mx-auto mb-6 border-2 border-dashed border-[#ebebeb]"><svg class="w-10 h-10 text-black/15"><use href="{% static 'asset/images/sprite.svg' %}#icons--shop"></use></svg></div>
<p class="text-[24px] font-din-black uppercase m-0 mb-2">Корзина пуста</p>
<p class="text-[14px] text-black/40 m-0 mb-8">Выберите товары в каталоге и возвращайтесь</p>
<a class="inline-block bg-black text-white px-10 py-4 rounded-[14px] font-bold text-[15px] no-underline hover:bg-black/80 transition-colors" href="{% url 'catalog:catalog' %}">Перейти в каталог</a>
</div>
        {% endif %}
    </div>
</main>

{# ═══ Edit Address Modal ═══ #}
<div id="edit-address-modal" onclick="if(event.target===this)closeEditModal()" style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.4);align-items:center;justify-content:center;padding:16px;display:none;" >
<div @click.stop="" style="background:#fff;border-radius:24px;padding:24px 28px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;">
<p style="font-family:'DIN Pro Black',sans-serif;font-size:32px;text-transform:uppercase;line-height:1.2;margin:0 0 24px;">Изменить адрес</p>
<div style="display:flex;flex-direction:column;gap:16px;">
<div class="tc-input"><label class="tc-input__label">Название</label><div class="tc-input__field"><input type="text" placeholder="Например, дом или работа" class="tc-input__field--input" id="edit-addr-label"/></div></div>
<div class="tc-input"><label class="tc-input__label">Город</label><div class="tc-input__field"><input type="text" placeholder="Укажите город" class="tc-input__field--input" id="edit-addr-city"/></div></div>
<div class="tc-input"><label class="tc-input__label">Улица</label><div class="tc-input__field"><input type="text" placeholder="Улица" class="tc-input__field--input" id="edit-addr-street"/></div></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
<div class="tc-input"><label class="tc-input__label">Дом</label><div class="tc-input__field"><input type="text" placeholder="Номер" class="tc-input__field--input" id="edit-addr-house"/></div></div>
<div class="tc-input"><label class="tc-input__label">Квартира / Офис</label><div class="tc-input__field"><input type="text" placeholder="Номер" class="tc-input__field--input" id="edit-addr-apartment"/></div></div>
</div>
<div class="tc-input"><label class="tc-input__label">Индекс</label><div class="tc-input__field"><input type="text" placeholder="Индекс" class="tc-input__field--input" id="edit-addr-postal" maxlength="6" oninput="this.value=this.value.replace(/[^0-9]/g,'').substring(0,6)"/></div></div>
</div>
<label class="tc-checkbox cursor-pointer" style="margin-top:16px;display:flex;align-items:center;gap:8px;cursor:pointer;"><input class="tc-checkbox__input cursor-pointer" type="checkbox" id="edit-addr-default"/><span class="tc-checkbox__text"><span>Сделать основным</span></span></label>
<div style="margin-top:24px;display:flex;flex-direction:column;gap:8px;">
<button type="button" class="tc-btn btn-dark w-full" onclick="saveEditAddress()"><span class="text-primary duration-200">Сохранить</span></button>
<button type="button" class="tc-btn btn-secondary w-full" onclick="closeEditModal()"><span class="text-primary duration-200">Отменить</span></button>
</div>
<button type="button" class="tc-btn btn-danger w-full" style="margin-top:8px;" onclick="deleteAddress()"><svg class="ic-left"><use href="{% static 'asset/images/sprite.svg' %}#icons--delete"></use></svg><span class="text-primary duration-200">Удалить</span></button>
</div>
</div>
</main>
<div id="login-modal-overlay" onclick="if(event.target===this)this.style.display='none'" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.4);align-items:center;justify-content:center;">
<div onclick="event.stopPropagation()" style="width:100%;max-width:488px;margin:0 16px;">
<form action="/login/" class="bg-white rounded-3xl p-6 md:p-8" method="post">
        {% csrf_token %}

        <div class="w-full mb-4">
<p class="text-[40px] font-din-black uppercase leading-[1.2] md:tracking-[0.01em] mb-0">Войти</p>
</div>
<div class="w-full space-y-8">
<div class="w-full space-y-4">
<div class="tc-input input-white xl:input-secondary">
<label class="tc-input__label" for="email-login-modal">Электронная почта</label>
<div class="tc-input__field">
<input autocomplete="email" class="tc-input__field--input" id="email-login-modal" name="email" type="email"/>
</div>
</div>
<div class="tc-input input-white xl:input-secondary" x-data="{ showPwd: false }">
<label class="tc-input__label" for="password-login-modal">Пароль</label>
<div class="tc-input__field">
<input :type="showPwd ? 'text' : 'password'" autocomplete="current-password" class="pr-10 tc-input__field--input" id="password-login-modal" name="password" placeholder="Пароль"/>
<button @click="showPwd = !showPwd" class="tc-input__field--btn-right" type="button">
<svg class="w-6 h-6" x-show="!showPwd"><use href="{% static 'images/sprite.svg' %}#icons--viewing-close"></use></svg>
<svg class="w-6 h-6" x-cloak="" x-show="showPwd"><use href="{% static 'images/sprite.svg' %}#icons--viewing-stroke"></use></svg>
</button>
</div>
</div>
</div>
<button class="tc-btn btn-dark w-full" type="submit">
<span class="text-primary duration-200">Войти</span>
</button>
<div class="w-full space-y-2">
<p class="text-[14px] leading-[1.3] medium">Войти через:</p>
<ul class="list-none p-0 m-0 flex flex-wrap overflow-auto items-center gap-2">
<li>
<a class="block cursor-pointer" href="{% provider_login_url 'yandex' %}">
<svg class="max-xl:text-white text-[var(--black-4)] h-11 w-11"><use href="{% static 'images/sprite.svg' %}#service--yandex-colored"></use></svg>
</a>
</li>
<li>
<a class="block cursor-pointer" href="{% provider_login_url 'vk' %}">
<svg class="max-xl:text-white text-[var(--black-4)] h-11 w-11"><use href="{% static 'images/sprite.svg' %}#service--vk-blue"></use></svg>
</a>
</li>
</ul>
</div>
<button class="tc-btn btn-white xl:btn-secondary w-full" onclick="window.location.href='{% url 'register' %}'" type="button">
<span class="text-primary duration-200">Регистрация</span>
</button>
</div>
</form>
</div>
</div>
<style>
.tc-checkbox-card{position:relative;display:block;width:280px;background:#ececec;border:1px solid #1a1a1a;border-radius:20px;padding:20px !important}
.tc-checkbox-card__input{appearance:none !important;-webkit-appearance:none !important;width:24px !important;height:24px !important;border:2.5px solid #1a1a1a !important;border-radius:6px !important;margin:0 !important;cursor:pointer !important;display:block !important;background:transparent !important;flex-shrink:0}
.tc-checkbox-card__input:checked{background:#1a1a1a !important;background-clip:content-box !important;padding:6px !important}
.button-edit-address{position:absolute;top:8px;right:8px;color:#333;cursor:pointer;z-index:100;width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.85);border-radius:10px;pointer-events:auto}
.button-edit-address svg{width:22px;height:22px}
.tc-checkbox-card__text{display:block;margin-top:12px;font-size:15px;line-height:1.2;color:#1a1a1a !important}
.tc-checkbox-card__header-title{font-size:14px !important;color:#1a1a1a !important;margin-left:8px}
.border-checked{position:absolute;inset:0;border-radius:20px;pointer-events:none !important;border:2px solid transparent;transition:border-color .2s;z-index:0}
.tc-checkbox-card__input:checked~.border-checked{border-color:#1a1a1a}
.checkout-card{background:#000;color:#fff;width:100%;border-radius:40px;padding:32px 28px}
.checkout-card .notice{color:#a0a0a5;font-size:15px;margin-bottom:16px}
.checkout-card .notice span{color:#fff}
.checkout-card .total-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:30px}
.checkout-card .total-label{font-family:'DIN Pro Black',sans-serif;font-size:38px;letter-spacing:1px;text-transform:uppercase}
.checkout-card .total-price{font-family:'DIN Pro Black',sans-serif;font-size:38px}
.checkout-card .price-details{margin-bottom:24px}
.checkout-card .price-row{display:flex;justify-content:space-between;font-size:17px;margin-bottom:16px;color:#fff}
.checkout-card .dots{flex-grow:1;border-bottom:1px dotted #333;margin:0 8px;position:relative;top:-4px}
.checkout-card .input-group{margin-bottom:24px}
.checkout-card .input-field{background:#262626;border-radius:14px;padding:16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;height:56px}
.checkout-card .input-field input{background:transparent;border:none;color:#fff;font-size:16px;width:70%;outline:none}
.checkout-card .input-field input::placeholder{color:#555}
.checkout-card .action-btn{color:#555;font-size:16px;cursor:pointer}
.checkout-card .info-section{margin-bottom:30px}
.checkout-card .info-text{color:#666;font-size:15px;line-height:1.4;margin-bottom:12px}
.checkout-card .submit-btn{background:#fff;color:#000;width:100%;border:none;border-radius:14px;padding:16px;font-size:16px;font-weight:700;text-transform:uppercase;cursor:pointer;margin-bottom:20px}
.checkout-card .terms-container{display:flex;align-items:flex-start;gap:12px;cursor:pointer}
.checkout-card .terms-container input{display:none}
.checkout-card .custom-checkbox{width:22px;height:22px;border:2px solid #333;border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#1a1a1a;margin-top:2px}
.checkout-card .terms-container input:checked+.custom-checkbox{background:#333;border-color:#333}
.checkout-card .custom-checkbox::after{content:"✓";color:#fff;font-size:14px;display:none}
.checkout-card .terms-container input:checked+.custom-checkbox::after{display:block}
.checkout-card .terms-text{color:#444;font-size:13px;line-height:1.4}
[x-cloak]{display:none!important}
.recipient-desktop{display:none}.recipient-mobile{display:block}
.delivery-desktop{display:none}.delivery-mobile{display:block}
@media(min-width:1100px){
    .recipient-desktop{display:block}.recipient-mobile{display:none}
    .delivery-desktop{display:block}.delivery-mobile{display:none}
    #basket-form{display:grid!important;grid-template-columns:2fr 1fr!important;gap:24px!important}
    #basket-left-col{grid-column:1!important;display:flex;flex-direction:column;gap:20px}
    #basket-sidebar{grid-column:2!important;position:sticky!important;top:100px!important;align-self:start!important}
}
</style>
<script>
function tcGetCookie(name) {
    const v = document.cookie.split(';').map(c => c.trim());
    for (const c of v) { if (c.startsWith(name + '=')) return decodeURIComponent(c.substring(name.length + 1)); }
    return '';
}
function tcUpdateCart(variantId, qty) {
    fetch('/basket/update/' + variantId + '/', {
        method: 'POST',
        headers: { 'X-CSRFToken': tcGetCookie('csrftoken'), 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'qty=' + qty
    }).then(function(r) { return r.json(); }).then(function(data) {
        if (!data.ok) return;
        var itemRow = document.querySelector('[data-variant-id="' + variantId + '"]');
        var serverQty = data.item_qty !== null && data.item_qty !== undefined ? data.item_qty : qty;
        if (itemRow) {
            var counterEl = itemRow.querySelector('.tc-counter__value');
            if (counterEl) counterEl.textContent = serverQty;
            var priceEl = itemRow.querySelector('.item-total-price');
            if (priceEl && data.item_total) priceEl.innerHTML = data.item_total + '<span class="rub"> \u20BD</span>';
            var btns = itemRow.querySelectorAll('.tc-counter__btn');
            if (btns[0]) {
                if (serverQty <= 1) { btns[0].removeAttribute('onclick'); btns[0].style.opacity = '0.3'; }
                else { btns[0].setAttribute('onclick', 'tcUpdateCart(' + variantId + ',' + (serverQty-1) + ')'); btns[0].style.opacity = '1'; }
            }
            if (btns[1]) {
                btns[1].setAttribute('onclick', 'tcUpdateCart(' + variantId + ',' + (serverQty+1) + ')');
            }
        }
        var totalEl = document.querySelector('.order-total-price');
        if (totalEl && data.total) totalEl.textContent = data.total + ' \u20BD';
        var badge = document.getElementById('header-cart-badge');
        if (badge && data.total_items !== undefined) {
            var spans = badge.querySelectorAll('span.block');
            if (spans[1]) spans[1].textContent = data.total_items;
        }
        document.body.dispatchEvent(new CustomEvent('cartUpdated'));
    });
}
function tcRemoveFromCart(variantId) {
    var itemRow = document.querySelector('[data-variant-id="' + variantId + '"]');
    if (itemRow) {
        itemRow.style.transition = 'opacity 0.3s';
        itemRow.style.opacity = '0';
        setTimeout(function() { itemRow.style.maxHeight = '0'; itemRow.style.overflow = 'hidden'; itemRow.style.padding = '0'; itemRow.style.margin = '0'; itemRow.style.border = 'none'; }, 300);
    }
    fetch('/basket/remove/' + variantId + '/', {
        method: 'POST',
        headers: { 'X-CSRFToken': tcGetCookie('csrftoken'), 'X-Requested-With': 'XMLHttpRequest' }
    }).then(function(r) { return r.json(); }).then(function(data) {
        setTimeout(function() { if (itemRow) itemRow.remove(); }, 600);
        // Update korzina count
        var korzinaEl = document.getElementById('korzina-count');
        if (korzinaEl && data.unique_count !== undefined) korzinaEl.textContent = data.unique_count;
        // Update checkout prices
        var totalEl = document.getElementById('checkout-total-price');
        if (totalEl && data.total) totalEl.textContent = data.total + ' \u20BD';
        var itemsEl = document.getElementById('checkout-items-price');
        if (itemsEl && data.total) itemsEl.textContent = data.total + ' \u20BD';
        // Update cart badge
        var badge = document.getElementById('header-cart-badge');
        if (badge && data.total_items !== undefined) {
            var spans = badge.querySelectorAll('span.block');
            if (spans[1]) spans[1].textContent = data.total_items;
        }
        document.body.dispatchEvent(new CustomEvent('cartUpdated'));
        // Reload if empty
        if (data.total_items !== undefined && data.total_items === 0) {
            setTimeout(function() { location.reload(); }, 500);
        }
    });
}
function tcPhoneMask(e) {
    var el = e.target;
    var len = parseInt(el.getAttribute('data-phone-length')) || 10;
    var raw = el.value.replace(/\D/g, '').slice(0, len);
    if (!raw) { el.value = ''; return; }
    var f = '';
    if (raw.length <= 3) {
        f = '(' + raw;
    } else if (raw.length <= 6) {
        f = '(' + raw.slice(0,3) + ') ' + raw.slice(3);
    } else if (raw.length <= 8) {
        f = '(' + raw.slice(0,3) + ') ' + raw.slice(3,6) + '-' + raw.slice(6);
    } else {
        f = '(' + raw.slice(0,3) + ') ' + raw.slice(3,6) + '-' + raw.slice(6,8) + '-' + raw.slice(8);
    }
    el.value = f;
}
</script>

{# ═══ Standalone Edit Address Script (independent of Alpine x-data) ═══ #}
<script>
(function() {
    var _editAddrId = "";

    function tcGetCookie(name) {
        var v = document.cookie.split(";").map(function(c) { return c.trim(); });
        for (var i = 0; i < v.length; i++) {
            if (v[i].indexOf(name + "=") === 0) return decodeURIComponent(v[i].substring(name.length + 1));
        }
        return "";
    }

    window.openEditModal = function(id, label, city, street, house, apartment, postalCode, isDefault) {
        _editAddrId = id;
        var el;
        el = document.getElementById("edit-addr-label"); if(el) el.value = label || "";
        el = document.getElementById("edit-addr-city"); if(el) el.value = city || "";
        el = document.getElementById("edit-addr-street"); if(el) el.value = street || "";
        el = document.getElementById("edit-addr-house"); if(el) el.value = house || "";
        el = document.getElementById("edit-addr-apartment"); if(el) el.value = apartment || "";
        el = document.getElementById("edit-addr-postal"); if(el) el.value = postalCode || "";
        el = document.getElementById("edit-addr-default"); if(el) el.checked = !!isDefault;
        var modal = document.getElementById("edit-address-modal");
        if (modal) modal.style.display = "flex";
    };

    window.closeEditModal = function() {
        var modal = document.getElementById("edit-address-modal");
        if (modal) modal.style.display = "none";
        _editAddrId = "";
    };

    window.saveEditAddress = function() {
        if (!_editAddrId) return;
        var body = new URLSearchParams({
            label: (document.getElementById("edit-addr-label") || {}).value || "",
            city: (document.getElementById("edit-addr-city") || {}).value || "",
            street: (document.getElementById("edit-addr-street") || {}).value || "",
            house: (document.getElementById("edit-addr-house") || {}).value || "",
            apartment: (document.getElementById("edit-addr-apartment") || {}).value || "",
            postal_code: (document.getElementById("edit-addr-postal") || {}).value || "",
            is_default: (document.getElementById("edit-addr-default") || {}).checked ? "true" : "false"
        });
        fetch("/basket/address/" + _editAddrId + "/edit/", {
            method: "POST",
            headers: {
                "X-CSRFToken": tcGetCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest",
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: body
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.ok) window.location.reload();
        });
    };

    window.deleteAddress = function() {
        if (!confirm("\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0430\u0434\u0440\u0435\u0441?")) return;
        if (!_editAddrId) return;
        fetch("/basket/address/" + _editAddrId + "/delete/", {
            method: "POST",
            headers: {
                "X-CSRFToken": tcGetCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest"
            }
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.ok) window.location.reload();
        });
    };
})();
</script>

{% endblock %}
