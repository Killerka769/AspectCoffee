{% extends "catalog/base.html" %}
{% load static %}

{% block title %}Интернет-магазин свежеобжаренного кофе{% endblock %}
{% block meta_description %}Интернет-магазин свежеобжаренного кофе Aspect Coffee. Ежедневная обжарка, бесплатная
доставка, большой выбор сортов. Купить кофе с доставкой по всей России.{% endblock %}
{% block og_title %}Aspect Coffee — свежеобжаренный кофе с бесплатной доставкой{% endblock %}

{% block content %}
<main>

    {# ===== БАННЕРЫ: ВЕРХ ГЛАВНОЙ ===== #}
    {% if home_top_banners %}
    <div class="w-full md:pt-8 pt-2 mb-8">
        <div class="container space-y-4">
            {% for banner in home_top_banners %}
            <a href="{{ banner.link_url|default:'#' }}" class="relative block min-h-[150px] md:min-h-[190px] overflow-hidden rounded-3xl bg-black text-white no-underline group">
                {% if banner.image %}<img src="{{ banner.image.url }}" alt="{{ banner.title }}" class="absolute inset-0 h-full w-full object-cover opacity-55 group-hover:opacity-70 transition-opacity">{% endif %}
                <div class="relative z-10 flex min-h-[150px] md:min-h-[190px] flex-col justify-center px-6 py-6 md:px-10">
                    <h2 class="font-din-black text-[28px] md:text-[40px] uppercase leading-tight">{{ banner.title }}</h2>
                    {% if banner.description %}<p class="mt-2 max-w-2xl text-[14px] md:text-[16px] text-white/75">{{ banner.description }}</p>{% endif %}
                    {% if banner.link_url %}<span class="mt-4 font-bold">{{ banner.button_label|default:"Перейти" }} →</span>{% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ===== HERO ===== #}
    <div class="w-full md:pt-10 pt-2 group-[.is-app]:pt-0 mb-11">
        <div class="container">
            <h1 class="w-0 h-0 opacity-0 text-[0px]">Интернет-магазин свежего кофе</h1>
            <p
                class="md:text-[64px] text-[40px] font-din uppercase md:leading-[1.1] leading-[1.2] md:mb-7 mb-4 md:max-w-[970px] max-w-[566px] tracking-normal">
                <span class="font-din-black sm:inline block">КАЖДЫЙ ДЕНЬ МЫ ОБЖАРИВАЕМ КОФЕ</span> И бесплатно
                доставляем по всей России
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 2xl:grid-cols-4 gap-y-3 md:gap-y-6 gap-x-6"
                x-data="{ hoverCard: null }">

                <a href="{% url 'catalog:catalog' %}?category=kofe&roast=espresso"
                    class="relative md:pt-[317px] pt-[127px] rounded-3xl bg-[var(--black)]" x-data="{ hovered: false }"
                    @mouseenter="hovered = true; $refs.video1 && ($refs.video1.currentTime = 0, $refs.video1.play())"
                    @mouseleave="hovered = false; $refs.video1 && $refs.video1.pause()">
                    <picture
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_60%]">
                        <source media="(max-width: 500px)" srcset="{% static 'asset/images/1b_small.webp' %}"
                            type="image/webp" />
                        <img alt="Кофе для эспрессо"
                            class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover"
                            src="{% static 'asset/images/1b.jpg' %}" />
                    </picture>
                    <video x-ref="video1" muted loop playsinline preload="none"
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_60%] transition-opacity duration-300"
                        :class="hovered ? '' : 'opacity-0'">
                        <source src="https://coffee-static.storage.yandexcloud.net/files/shares/home/espresso.mp4"
                            type="video/mp4" />
                    </video>
                    <span
                        class="rounded-[inherit] absolute top-0 left-0 w-full h-full text-[var(--white)] py-5 xl:py-10 xl:px-4 text-[32px] md:text-[40px] font-din-light uppercase leading-[1.2] text-center tracking-[1.4px] flex flex-col items-center justify-center">
                        кофе <b class="font-din-black font-normal">для<br>эспрессо</b>
                        <small class="font-din-black block text-[24px] text-[var(--black-50)]">{{ espresso_count }}</small>
                    </span>
                </a>
                <a href="{% url 'catalog:catalog' %}?category=kofe&roast=light,medium"
                    class="relative md:pt-[317px] pt-[127px] rounded-3xl bg-[var(--black)]" x-data="{ hovered: false }"
                    @mouseenter="hovered = true; $refs.video2 && ($refs.video2.currentTime = 0, $refs.video2.play())"
                    @mouseleave="hovered = false; $refs.video2 && $refs.video2.pause()">
                    <picture
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_55%]">
                        <source media="(max-width: 500px)" srcset="{% static 'asset/images/3b_small.webp' %}"
                            type="image/webp" />
                        <img alt="Кофе для фильтра"
                            class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover"
                            src="{% static 'asset/images/3b.jpg' %}" />
                    </picture>
                    <video x-ref="video2" muted loop playsinline preload="none"
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_55%] transition-opacity duration-300"
                        :class="hovered ? '' : 'opacity-0'">
                        <source src="https://coffee-static.storage.yandexcloud.net/files/shares/home/filter.mp4"
                            type="video/mp4" />
                    </video>
                    <span
                        class="rounded-[inherit] absolute top-0 left-0 w-full h-full text-[var(--white)] py-5 xl:py-10 xl:px-4 text-[32px] md:text-[40px] font-din-light uppercase leading-[1.2] text-center tracking-[1.4px] flex flex-col items-center justify-center">
                        кофе <b class="font-din-black font-normal">для<br>фильтра</b>
                        <small class="font-din-black block text-[24px] text-[var(--black-50)]">{{ filter_count }}</small>
                    </span>
                </a>



                <a href="{% url 'catalog:catalog' %}?category=aksessuary"
                    class="relative md:pt-[317px] pt-[127px] rounded-3xl bg-[var(--black)]" x-data="{ hovered: false }"
                    @mouseenter="hovered = true; $refs.video3 && ($refs.video3.currentTime = 0, $refs.video3.play())"
                    @mouseleave="hovered = false; $refs.video3 && $refs.video3.pause()">
                    <picture
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_40%]">
                        <img alt="Аксессуары и мерч"
                            class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover"
                            src="{% static 'asset/images/accessories.jpg' %}" />
                    </picture>
                    <video x-ref="video3" muted loop playsinline preload="none"
                        class="absolute top-0 left-0 w-full h-full rounded-[inherit] object-cover controls-hide max-md:object-[center_40%] transition-opacity duration-300"
                        :class="hovered ? '' : 'opacity-0'">
                        <source src="https://coffee-static.storage.yandexcloud.net/files/shares/home/acsr.mp4"
                            type="video/mp4" />
                    </video>
                    <span
                        class="rounded-[inherit] absolute top-0 left-0 w-full h-full text-[var(--white)] py-5 xl:py-10 xl:px-4 text-[32px] md:text-[40px] font-din-light uppercase leading-[1.2] text-center tracking-[1.4px] flex flex-col items-center justify-center">
                        <b class="font-din-black font-normal">Аксессуары и мерч</b>
                        <small class="font-din-black block text-[24px] text-[var(--black-50)]">{{ accessories_count }}</small>
                    </span>
                </a>

                <div>
                    <div
                        class="w-full bg-white space-y-4 rounded-3xl h-full p-6 max-2xl:md:flex max-2xl:md:justify-between max-2xl:md:items-center max-2xl:md:space-y-0">
                        {% if request.user.is_authenticated %}
                        {% if has_ordered %}
                        <div class="space-y-4">
                            <p class="text-[24px] font-din-black uppercase leading-[1.2] md:tracking-[0.02em]">
                                <span>Спасибо</span> <span class="md:max-2xl:inline-block block font-din">За
                                    заказ!</span>
                            </p>
                            <p class="text-[var(--black-50)] text-[14px]">Рады, что вы у нас. Если что-то не так —
                                напишите нам.</p>
                            <div class="flex gap-2 mt-4">
                                <a href="{% url 'users:profile' %}" class="tc-btn btn-dark flex-1 text-center"><span
                                        class="text-primary duration-200">Перейти в профиль</span></a>
                                <a href="{% url 'my_favorites' %}" class="tc-btn btn-secondary flex-1 text-center"><span
                                        class="duration-200">Избранное</span></a>
                            </div>
                        </div>
                        {% else %}
                        <div class="space-y-4">
                            <p class="text-[24px] font-din-black uppercase leading-[1.2] md:tracking-[0.02em]">
                                <span>Скидка</span> 15% <span class="md:max-2xl:inline-block block font-din">НА ПЕРВЫЙ
                                    ЗАКАЗ</span>
                            </p>
                            <div class="relative w-full">
                                <div class="tc-input">
                                    <div class="tc-input__field">
                                        <input type="text" placeholder="Промокод" disabled
                                            class="tc-input__field--input" value="FRST15">
                                        <button class="tc-input__field--btn-right" type="button"
                                            onclick="navigator.clipboard.writeText('FRST15')">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <button class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" tabindex="-1"
                                    onclick="navigator.clipboard.writeText('FRST15')">FRST15</button>
                            </div>
                        </div>
                        <div
                            class="space-y-2 max-2xl:md:flex-col max-2xl:md:items-end max-2xl:md:flex max-2xl:md:justify-end max-2xl:md:space-x-2 max-2xl:md:*:!w-auto max-2xl:md:space-y-0 max-2xl:md:!-mb-2">
                            <form method="POST" action="{% url 'orders:apply_promo' %}" class="w-full">
                                {% csrf_token %}
                                <input type="hidden" name="code" value="FRST15">
                                <input type="hidden" name="next" value="{{ request.path }}">
                                <button type="submit" class="tc-btn btn-dark w-full"><span
                                        class="text-primary duration-200">Применить</span></button>
                            </form>
                            <p
                                class="text-[var(--black-50)] max-2xl:md:max-w-[400px] max-2xl:md:text-right max-2xl:md:!mt-1.5">
                                Скидка действует на весь кофе и чай, кроме сортов недели и месяца, при заказе от 1000
                                <span class="rub">₽</span></p>
                        </div>
                        {% endif %}
                        {% else %}
                        <div class="flex-1 flex flex-col justify-between w-full">
                            <div>
                                <p class="text-[24px] font-din-black uppercase leading-[1.2] mb-1">Войдите, <span
                                        class="font-din">и станет дешевле</span></p>
                                <p class="text-black/50 text-[14px]">В личном кабинете больше персональных предложений и
                                    скидок</p>
                            </div>
                            <div class="mt-6 flex flex-col gap-2">
                                <a href="{% url 'login' %}"
                                    class="bg-black text-white font-bold px-6 py-3 rounded-xl text-[14px] hover:opacity-80 transition-opacity text-center block uppercase">Войти</a>
                                <a href="{% url 'register' %}"
                                    class="bg-gray-100 text-black font-bold px-6 py-3 rounded-xl text-[14px] hover:bg-gray-200 transition-colors text-center block uppercase">Регистрация</a>
                                <div class="grid grid-cols-2 gap-2">
                                    <a href="/accounts/yandex/login/"
                                        class="flex items-center justify-center hover:opacity-80 transition-opacity py-3 bg-gray-50 rounded-xl"
                                        title="Войти через Яндекс">
                                        <img src="https://yastatic.net/s3/home-static/_/Z/6/nfVezDRqofwQZ5e669DSK84Tw.svg"
                                            width="28" height="28" alt="Яндекс">
                                    </a>
                                    <a href="/accounts/vk/login/"
                                        class="flex items-center justify-center hover:opacity-80 transition-opacity py-3 bg-gray-50 rounded-xl"
                                        title="Войти через VK">
                                        <svg width="28" height="28" viewBox="0 0 101 100" fill="none"
                                            xmlns="http://www.w3.org/2000/svg">
                                            <path
                                                d="M0.5 48C0.5 25.3726 0.5 14.0589 7.52944 7.02944C14.5589 0 25.8726 0 48.5 0H52.5C75.1274 0 86.4411 0 93.4706 7.02944C100.5 14.0589 100.5 25.3726 100.5 48V52C100.5 74.6274 100.5 85.9411 93.4706 92.9706C86.4411 100 75.1274 100 52.5 100H48.5C25.8726 100 14.5589 100 7.52944 92.9706C0.5 85.9411 0.5 74.6274 0.5 52V48Z"
                                                fill="#0077FF" />
                                            <path
                                                d="M53.7085 72.042C30.9168 72.042 17.9169 56.417 17.3752 30.417H28.7919C29.1669 49.5003 37.5834 57.5836 44.25 59.2503V30.417H55.0004V46.8752C61.5837 46.1669 68.4995 38.667 70.8329 30.417H81.5832C79.7915 40.5837 72.2915 48.0836 66.9582 51.1669C72.2915 53.6669 80.8336 60.2086 84.0836 72.042H72.2499C69.7082 64.1253 63.3754 58.0003 55.0004 57.1669V72.042H53.7085Z"
                                                fill="white" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>

            </div>
        </div>
    </div>

    {# ===== TAYMER ===== #}
    {% if site_settings.roast_banner_is_active %}
    <div class="w-full mb-11">
        <div class="container">
            <div class="bg-black text-white rounded-3xl px-8 py-6 flex flex-wrap items-center gap-6 justify-between">
                <div x-data="{
                    time: '00:00:00',
                    update() {
                        const now = new Date();
                        const msk = new Date(now.toLocaleString('en-US', {timeZone: 'Europe/Moscow'}));
                        const midnight = new Date(msk);
                        midnight.setHours(24, 0, 0, 0);
                        const diff = midnight - msk;
                        const h = Math.floor(diff / 3600000);
                        const m = Math.floor((diff % 3600000) / 60000);
                        const s = Math.floor((diff % 60000) / 1000);
                        this.time = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
                    }
                }" x-init="update(); setInterval(() => update(), 1000)">
                    {% if site_settings.roast_banner_title %}
                    <p class="text-[13px] text-white/50 uppercase tracking-widest mb-1">{{ site_settings.roast_banner_title }}</p>
                    {% endif %}
                    <span x-text="time"
                        class="text-[48px] font-din-black leading-none tabular-nums block">00:00:00</span>
                    {% if site_settings.roast_banner_subtitle %}
                    <p class="text-[13px] text-white/40 mt-2">{{ site_settings.roast_banner_subtitle }}</p>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
    {% endif %}


    {# ===== SORTA NEDELI ===== #}
    <div class="w-full mb-11">
        <div class="container">


            <div class="flex items-center justify-between mb-6">
                <h2 class="text-[40px]"><span class="sm:inline block mr-2">Сорта недели</span><span class="font-din">со
                        скидкой</span></h2>
                <a href="{% url 'catalog:catalog' %}?qfilter=week"
                    class="text-sm text-black/50 hover:text-black transition-colors">Смотреть все →</a>
            </div>

            {# 2 карточки товара и промо-слайдер рядом #}
            <div class="tc-weekly-with-slider">
                {# Слева: 2 карточки товара #}
                {% for product in week_specials|slice:":2" %}
                <div class="tc-weekly-card">
                    {% include "catalog/_product_card.html" with product=product is_index=True %}
                </div>
                {% empty %}
                <div class="tc-weekly-card text-center py-8 text-black/40">Нет товаров</div>
                {% endfor %}

                {# O'ng: promo banner slider (dynamically loaded from DB) #}
                <div class="tc-promo-slider" x-data="{
                        idx: 0,
                        total: 0,
                        timer: null,
                        start() { this.total = this.$el.querySelectorAll('.tc-promo-slide').length; if (this.total > 1) this.timer = setInterval(() => { this.idx = (this.idx + 1) % this.total; }, 5000); },
                        stop() { clearInterval(this.timer); }
                     }" x-init="start()" @mouseenter="stop()" @mouseleave="start()">

                    {% for slide in promo_slides %}
                    {% if slide.is_usp %}
                    {# Slide: USP (Таймер обжарки) #}
                    <div class="tc-promo-slide swiper-slide bg-[var(--black)] md:px-8 md:pt-8 md:pb-20 px-5 pt-5 pb-12 relative h-full flex flex-col items-start space-y-2.5 md:space-y-5"
                        :class="idx === {{ forloop.counter0 }} ? 'swiper-slide-active active' : ''" data-swiper-slide-index="{{ forloop.counter0 }}"
                        x-data="{
                            hours: 15,
                            update() {
                                const now = new Date();
                                const msk = new Date(now.toLocaleString('en-US', {timeZone: 'Europe/Moscow'}));
                                const midnight = new Date(msk);
                                midnight.setHours(24, 0, 0, 0);
                                const diff = midnight - msk;
                                this.hours = Math.floor(diff / 3600000);
                            }
                        }" x-init="update(); setInterval(() => update(), 60000)">
                        {% if slide.usp_line_1_html %}
                        <p class="2xl:text-[42px] xl:text-[28px] md:text-[42px] text-[20px] uppercase leading-[1.2] text-[var(--white)] font-din-light m-0">
                            {{ slide.usp_line_1_html|safe }}
                        </p>
                        {% endif %}
                        {% if slide.usp_line_2_html %}
                        <p class="2xl:text-[42px] xl:text-[28px] md:text-[42px] text-[20px] uppercase leading-[1.2] text-[var(--white)] font-din-light m-0">
                            {{ slide.usp_line_2_html|safe }}
                        </p>
                        {% endif %}
                        {% if slide.usp_line_3_html %}
                        <p class="2xl:text-[42px] xl:text-[28px] md:text-[42px] text-[20px] uppercase leading-[1.2] text-[var(--white)] font-din-light m-0">
                            {{ slide.usp_line_3_html|safe }}
                        </p>
                        {% endif %}
                        {% with bg=slide.get_bg_url %}
                        {% if bg %}
                        <picture>
                            <img class="absolute top-0 left-0 w-full h-full rounded-3xl -z-10 object-cover opacity-40 !m-0"
                                src="{{ bg }}" alt="{{ slide.title }}">
                        </picture>
                        {% endif %}
                        {% endwith %}
                    </div>
                    {% else %}
                    {# Слайды из БД (управляются через Django admin → Промо-слайды) #}
                    <div class="tc-promo-slide swiper-slide bg-[var(--black)] md:px-8 md:pt-8 md:pb-20 px-5 pt-5 pb-12 relative h-full flex flex-col items-start space-y-5"
                        :class="idx === {{ forloop.counter0 }} ? 'swiper-slide-active active' : ''"
                        data-swiper-slide-index="{{ forloop.counter0 }}">
                        <p
                            class="2xl:text-[42px] xl:text-[28px] md:text-[42px] text-[20px] uppercase leading-[1.2] text-[var(--white)] font-din-light m-0">
                            {% if slide.section_label %}<span class="block">{{ slide.section_label }}</span>{% endif %}
                            <span class="font-din-black block">{{ slide.title }}</span>
                        </p>
                        {% if slide.link_url %}
                        <a href="{{ slide.link_url }}" class="tc-btn btn-white">
                            <span class="text-primary duration-200">{{ slide.link_text|default:"Читать статью" }}</span>
                        </a>
                        {% endif %}
                        {% with bg=slide.get_bg_url %}
                        {% if bg %}
                        <img alt="{{ slide.title }}" loading="lazy"
                            class="absolute top-0 left-0 w-full h-full rounded-3xl -z-10 object-cover !m-0"
                            style="opacity: {{ slide.image_opacity }}"
                            src="{{ bg }}">
                        {% endif %}
                        {% endwith %}
                    </div>
                    {% endif %}
                    {% endfor %}
                    {% for banner in home_weekly_banners %}
                    <a href="{{ banner.link_url|default:'#' }}" class="tc-promo-slide swiper-slide bg-[var(--black)] relative overflow-hidden p-7 text-white no-underline" :class="idx === {{ promo_slides|length|add:forloop.counter0 }} ? 'swiper-slide-active active' : ''">
                        {% if banner.image %}<img src="{{ banner.image.url }}" alt="{{ banner.title }}" class="absolute inset-0 h-full w-full object-cover opacity-45">{% endif %}
                        <div class="relative"><p class="font-din-black uppercase text-[28px] leading-tight m-0">{{ banner.title }}</p>{% if banner.description %}<p class="text-white/75 mt-3">{{ banner.description }}</p>{% endif %}<span class="inline-block mt-3 font-bold">{{ banner.button_label|default:"Перейти" }} →</span></div>
                    </a>
                    {% endfor %}

                    {# Navigation: dots chapda, arrows o'ngda (pastda) #}
                    <div class="tc-promo-nav">
                        <div class="tc-promo-dots">
                            <template x-for="i in total" :key="i">
                                <button type="button" @click="idx = i - 1"
                                    :class="{ 'active': idx === (i - 1) }"></button>
                            </template>
                        </div>
                        <div class="tc-promo-arrows">
                            <button type="button" class="tc-promo-arrow" @click="idx = (idx - 1 + total) % total"
                                aria-label="Предыдущий">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 12H5" />
                                    <path d="M12 19l-7-7 7-7" />
                                </svg>
                            </button>
                            <button type="button" class="tc-promo-arrow" @click="idx = (idx + 1) % total"
                                aria-label="Следующий">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14" />
                                    <path d="M12 5l7 7-7 7" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ===== БАННЕРЫ: НИЗ ГЛАВНОЙ ===== #}
    {% if home_bottom_banners %}
    <div class="w-full mb-11">
        <div class="container grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for banner in home_bottom_banners %}
            <a href="{{ banner.link_url|default:'#' }}" class="relative block min-h-[180px] overflow-hidden rounded-3xl bg-black text-white no-underline group">
                {% if banner.image %}<img src="{{ banner.image.url }}" alt="{{ banner.title }}" class="absolute inset-0 h-full w-full object-cover opacity-55 group-hover:opacity-70 transition-opacity">{% endif %}
                <div class="relative z-10 flex min-h-[180px] flex-col justify-end px-6 py-6">
                    <h2 class="font-din-black text-[24px] uppercase leading-tight">{{ banner.title }}</h2>
                    {% if banner.description %}<p class="mt-2 text-[14px] text-white/75">{{ banner.description }}</p>{% endif %}
                    {% if banner.link_url %}<span class="mt-3 font-bold">{{ banner.button_label|default:"Перейти" }} →</span>{% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ===== USP ===== #}
    <div class="w-full mb-11">
        <div class="container">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-[#f5f5f5] rounded-2xl p-6 flex items-start gap-4">
                    <svg class="w-10 h-10 flex-shrink-0" aria-hidden="true">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--delivery"></use>
                    </svg>
                    <div>
                        <p class="font-bold text-[17px] mb-1">Бесплатная доставка</p>
                        <p class="text-[14px] text-black/50">При заказе от 600 ₽ — доставка бесплатна в большинство
                            городов России.</p>
                    </div>
                </div>
                <div class="bg-[#f5f5f5] rounded-2xl p-6 flex items-start gap-4">
                    <svg class="w-10 h-10 flex-shrink-0" aria-hidden="true">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--eco-swap-2"></use>
                    </svg>
                    <div>
                        <p class="font-bold text-[17px] mb-1">Гарантия качества</p>
                        <p class="text-[14px] text-black/50">Если кофе не понравится — бесплатно заменим на другой сорт
                            или вернём деньги.</p>
                    </div>
                </div>
                <div class="bg-[#f5f5f5] rounded-2xl p-6 flex items-start gap-4">
                    <svg class="w-10 h-10 flex-shrink-0" aria-hidden="true">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--coffee"></use>
                    </svg>
                    <div>
                        <p class="font-bold text-[17px] mb-1">Ежедневная обжарка</p>
                        <p class="text-[14px] text-black/50">Обжариваем кофе каждый день — не более 2–3 дней с момента
                            обжарки до вашей двери.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ===== YANGI ===== #}
    <div class="w-full mb-11">
        <div class="container">
            <h2 class="text-[40px] mb-6">
                <a class="group text-[40px] font-din-black uppercase leading-[1.2] inline-block no-underline text-[var(--black)]"
                    href="{% url 'catalog:catalog' %}?qfilter=new">
                    <span class="mr-1 group-hover:underline underline-offset-8">Новое</span>
                    <svg class="h-[24px] w-[24px] -mt-1 inline">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--arr-right-bold"></use>
                    </svg>
                </a>
            </h2>
            <div class="grid grid-cols-12 gap-y-3 md:gap-y-6 gap-x-6">
                {% for product in new_arrivals %}
                <div class="col-span-12 md:col-span-6 2xl:col-span-3 flex">
                    {% include "catalog/_product_card.html" with product=product is_index=True %}
                </div>
                {% empty %}
                <div class="col-span-12 text-center py-8 text-black/40">Нет новинок</div>
                {% endfor %}
                {% for banner in new_block_banners %}
                <div class="col-span-12 md:col-span-6 2xl:col-span-3 flex">
                    {% include "catalog/_banner_card.html" with banner=banner %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ===== MASHHUR ===== #}
    <div class="w-full mb-11">
        <div class="container">
            <h2 class="text-[40px] mb-6">
                <a class="group text-[40px] font-din-black uppercase leading-[1.2] inline-block no-underline text-[var(--black)]"
                    href="{% url 'catalog:catalog' %}?qfilter=popular">
                    <span class="mr-1 group-hover:underline underline-offset-8">Популярное</span>
                    <svg class="h-[24px] w-[24px] -mt-1 inline">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--arr-right-bold"></use>
                    </svg>
                </a>
            </h2>
            <div class="grid grid-cols-12 gap-y-3 md:gap-y-6 gap-x-6">
                {% for product in popular %}
                <div class="col-span-12 md:col-span-6 2xl:col-span-3 flex">
                    {% include "catalog/_product_card.html" with product=product is_index=True %}
                </div>
                {% endfor %}
                {% for banner in popular_block_banners %}
                <div class="col-span-12 md:col-span-6 2xl:col-span-3 flex">
                    {% include "catalog/_banner_card.html" with banner=banner %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ===== NABORY (GIFT SETS) ===== #}
    {% if gift_sets %}
    <div class="w-full mb-11">
        <div class="container">
            <h2 class="text-[40px] mb-6">
                <a class="group text-[40px] font-din-black uppercase leading-[1.2] inline-block no-underline text-[var(--black)]"
                    href="/catalog/?category=giftbox">
                    <span class="mr-1 group-hover:underline underline-offset-8">Наборы</span>
                    <svg class="h-[24px] w-[24px] -mt-1 inline">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--arr-right-bold"></use>
                    </svg>
                </a>
            </h2>
            <div class="grid grid-cols-12 gap-y-3 md:gap-y-6 gap-x-6">
                {% for product in gift_sets %}
                <div class="col-span-12 md:col-span-6 2xl:col-span-3 flex">
                    {% include "catalog/_product_card.html" with product=product is_index=True %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    {# ===== SHARHLAR (REVIEWS) ===== #}
    <div class="w-full mb-11 bg-[#f5f5f5] py-12">
        <div class="container">
            <div class="flex flex-wrap items-end justify-between mb-8 gap-4">
                <h2 class="text-[40px] font-din-black uppercase leading-[1.2] m-0">Отзывы</h2>
                <div class="flex gap-8 text-center">
                    <div>
                        <p class="text-[32px] font-din-black leading-[1.2] m-0">{{ reviews_count }}</p>
                        <p class="text-[13px] text-black/50 m-0">отзыв</p>
                    </div>
                    <div>
                        <p class="text-[32px] font-din-black leading-[1.2] m-0">{{ rating_avg }}</p>
                        <p class="text-[13px] text-black/50 m-0">Средняя оценка магазина</p>
                    </div>
                    <div>
                        <p class="text-[32px] font-din-black leading-[1.2] m-0">{{ delivery_rating_avg }}</p>
                        <p class="text-[13px] text-black/50 m-0">Средняя оценка доставки</p>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% for review in recent_reviews %}
                    {% include "catalog/_review_card.html" %}
                {% empty %}
                <div class="bg-white rounded-2xl p-6 col-span-2 text-center text-black/40">Пока нет отзывов</div>
                {% endfor %}
            </div>
            <div class="text-center mt-8">
                <a href="{% url 'pages:reviews' %}"
                    class="inline-flex items-center gap-2 bg-black text-white font-bold px-6 py-3 rounded-xl hover:bg-gray-800 transition-colors text-[14px] no-underline">
                    Все отзывы
                    <svg class="w-4 h-4">
                        <use href="{% static 'asset/images/sprite.svg' %}#icons--arr-right-bold"></use>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    {# ===== POLNAYA OTKRYTOST (LIVESTREAM) ===== #}
    {% if site_settings.openness_title %}
    <div class="w-full mb-11">
        <div class="container">
            <h2 class="text-[40px] font-din-black uppercase leading-[1.2] mb-4">{{ site_settings.openness_title }}</h2>
            {% if site_settings.openness_description %}
            <p class="text-[18px] text-black/60 mb-8 max-w-[720px]">{{ site_settings.openness_description }}</p>
            {% endif %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% if site_settings.openness_stream_1_title %}
                <a href="{{ site_settings.openness_stream_1_url|default:'#' }}" class="relative block rounded-2xl overflow-hidden bg-black group"
                    style="aspect-ratio:16/10;">
                    <img src="{% if site_settings.openness_stream_1_image %}{{ site_settings.openness_stream_1_image.url }}{% else %}{% static 'asset/images/1b.jpg' %}{% endif %}" alt="{{ site_settings.openness_stream_1_title }}"
                        class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity">
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-white z-10">
                        <svg class="w-12 h-12 mb-2 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        <p class="text-[16px] font-din-black uppercase tracking-wider">{{ site_settings.openness_stream_1_title }}</p>
                    </div>
                </a>
                {% endif %}
                {% if site_settings.openness_stream_2_title %}
                <a href="{{ site_settings.openness_stream_2_url|default:'#' }}" class="relative block rounded-2xl overflow-hidden bg-black group"
                    style="aspect-ratio:16/10;">
                    <img src="{% if site_settings.openness_stream_2_image %}{{ site_settings.openness_stream_2_image.url }}{% else %}{% static 'asset/images/3b.jpg' %}{% endif %}" alt="{{ site_settings.openness_stream_2_title }}"
                        class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity">
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-white z-10">
                        <svg class="w-12 h-12 mb-2 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        <p class="text-[16px] font-din-black uppercase tracking-wider">{{ site_settings.openness_stream_2_title }}</p>
                    </div>
                </a>
                {% endif %}
                {% if site_settings.openness_stream_3_title %}
                <a href="{{ site_settings.openness_stream_3_url|default:'#' }}" class="relative block rounded-2xl overflow-hidden bg-black group"
                    style="aspect-ratio:16/10;">
                    <img src="{% if site_settings.openness_stream_3_image %}{{ site_settings.openness_stream_3_image.url }}{% else %}{% static 'asset/images/accessories.jpg' %}{% endif %}" alt="{{ site_settings.openness_stream_3_title }}"
                        class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity">
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-white z-10">
                        <svg class="w-12 h-12 mb-2 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        <p class="text-[16px] font-din-black uppercase tracking-wider">{{ site_settings.openness_stream_3_title }}</p>
                    </div>
                </a>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

</main>
{% endblock %}
