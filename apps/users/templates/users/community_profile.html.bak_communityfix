{% extends "users/base_account.html" %}{% load static %}{% block account_content %}
<div class="col-span-12 xl:col-span-10 2xl:col-span-9 space-y-[18px] md:space-y-6">
  <h2 class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Профиль в сообществе</h2>

  {# PROFILE CARD #}
  <div class="bg-[var(--white)] rounded-2xl p-6 flex flex-col md:flex-row items-start md:items-center gap-6 group">
    <div class="w-20 h-20 rounded-full bg-[var(--black-4)] flex items-center justify-center overflow-hidden shrink-0">
      {% if user.avatar %}
      <img src="{{ user.avatar }}" class="w-full h-full object-cover">
      {% else %}
      <svg class="w-10 h-10 text-[var(--black-30)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      {% endif %}
    </div>
    <div class="flex-1 min-w-0">
      <div class="font-din-black text-[24px] uppercase leading-[1.2]">{{ user.username|default:user.email }}</div>
      {% if community_stats.review_count is not None %}
      <div class="flex flex-wrap gap-4 mt-2 text-[13px] text-[var(--black-50)]">
        <span class="flex items-center gap-1"><svg class="w-4 h-4 text-[var(--black-50)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.906a1 1 0 00.95-.69l1.519-4.674z" /></svg>{{ community_stats.review_count|default:0 }} отзывов</span>
        <span class="flex items-center gap-1"><svg class="w-4 h-4 text-[var(--black-50)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>{{ community_stats.like_count|default:0 }} отметок</span>
        <span class="flex items-center gap-1"><svg class="w-4 h-4 text-[var(--black-50)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>{{ community_stats.post_count|default:0 }} публикаций</span>
      </div>
      {% endif %}
    </div>
    <div class="shrink-0 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:scale-105">
      <a href="{% url 'users:profile' %}" class="tc-btn btn-dark btn-xs" style="text-decoration:none;">Редактировать</a>
    </div>
  </div>

  {# SHARE LINK #}
  <div class="bg-[var(--black-4)] rounded-2xl p-4 flex items-center justify-between flex-wrap gap-2">
    <span class="text-[14px]">Поделиться ссылкой <strong>@{{ user.username }}</strong> в соцсетях</span>
    <button onclick="navigator.clipboard.writeText('{{ request.build_absolute_uri }}')" class="px-4 py-2 rounded-xl text-[11px] font-din-black uppercase tracking-[0.04em] bg-[var(--white)] hover:bg-[var(--black-4)]">Скопировать</button>
  </div>

  {# USER POSTS #}
  {% if user_posts %}
  <div class="space-y-3">
    <h3 class="text-[14px] font-din-black uppercase tracking-[0.1em] text-[var(--black-50)] m-0">Мои статьи</h3>
    {% for p in user_posts %}
    <div class="bg-[var(--white)] rounded-xl p-4">
      <div class="flex items-start justify-between gap-3 mb-2">
        <div class="font-din-black text-[16px] leading-[1.2]">{{ p.title }}</div>
        <div class="flex items-center gap-2 shrink-0">
          <div class="text-[11px] text-[var(--black-50)] whitespace-nowrap">{{ p.created_at|date:"d.m.Y" }}</div>
          <a href="{% url 'pages:community_post_edit' p.pk %}" class="w-8 h-8 rounded-lg bg-[var(--black-4)] hover:bg-[var(--black-5)] flex items-center justify-center transition-colors" title="Редактировать">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </a>
          <form method="post" action="{% url 'pages:community_post_delete' p.pk %}" onsubmit="return confirm('Удалить запись?')">
            {% csrf_token %}
            <button type="submit" class="w-8 h-8 rounded-lg bg-[var(--black-4)] hover:bg-red-50 flex items-center justify-center transition-colors" title="Удалить">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </form>
        </div>
      </div>
      <div class="text-[13px] text-[var(--black-50)]">{{ p.text|truncatechars:200 }}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="col-span-12 pt-8 text-center flex flex-col items-center">
    <div class="w-20 h-20 bg-[var(--white)] rounded-full flex items-center justify-center mb-6">
      <svg class="w-10 h-10 text-[var(--black-16)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
    </div>
    <p class="text-[18px] font-din-black uppercase m-0">Нет статей</p>
    <p class="text-[13px] text-[var(--black-50)] mt-2 m-0">Напишите свой первый пост в сообществе</p>
    <a href="/community/" class="tc-btn btn-dark mt-4" style="text-decoration:none;">Перейти в сообщество</a>
  </div>
  {% endif %}
</div>
{% endblock %}
