{% extends "users/base_account.html" %}{% load static %}{% block account_content %}
<div class="space-y-8">
  <h2 class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Внутренний счёт</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {# BALANCE ICON #}
    <div class="bg-[var(--white)] rounded-2xl p-6 flex items-center justify-center">
      <img width="100" height="100" src="https://img.icons8.ru/ios/100/credit-card-front.png" alt="credit-card-front">
    </div>

    {# TOP-UP FORM #}
    <form method="post" action="{% url 'users:topup_balance' %}" class="bg-[var(--white)] rounded-2xl p-6 space-y-3">
      {% csrf_token %}
      <div class="text-[11px] text-[var(--black-50)] font-din-black uppercase tracking-[0.1em] mb-3">Пополнить</div>
      <label class="block text-[12px] font-din-black uppercase tracking-[0.04em]">Сумма (₽)</label>
      <div class="tc-input">
        <div class="tc-input__field">
          <input type="number" name="amount" min="100" max="100000" step="100" value="1000" required class="tc-input__field--input">
        </div>
      </div>
      <div class="flex gap-2 flex-wrap">
        <button type="button" onclick="this.form.amount.value=500" class="px-3 py-1.5 bg-[var(--black-4)] rounded-lg text-[12px] font-din-black hover:bg-[var(--black-5)]">500</button>
        <button type="button" onclick="this.form.amount.value=1000" class="px-3 py-1.5 bg-[var(--black-4)] rounded-lg text-[12px] font-din-black hover:bg-[var(--black-5)]">1 000</button>
        <button type="button" onclick="this.form.amount.value=3000" class="px-3 py-1.5 bg-[var(--black-4)] rounded-lg text-[12px] font-din-black hover:bg-[var(--black-5)]">3 000</button>
        <button type="button" onclick="this.form.amount.value=5000" class="px-3 py-1.5 bg-[var(--black-4)] rounded-lg text-[12px] font-din-black hover:bg-[var(--black-5)]">5 000</button>
        <button type="button" onclick="this.form.amount.value=10000" class="px-3 py-1.5 bg-[var(--black-4)] rounded-lg text-[12px] font-din-black hover:bg-[var(--black-5)]">10 000</button>
      </div>
      <button type="submit" class="tc-btn btn-dark w-full">Пополнить</button>
      <div class="text-[10px] text-[var(--black-50)] text-center">Мин. 100 ₽ · макс. 100 000 ₽</div>
    </form>
  </div>

  {# BONUS PROGRAM INFO #}
  <div class="bg-[var(--white)] rounded-2xl p-6 space-y-4">
    <div class="text-[11px] text-[var(--black-50)] font-din-black uppercase tracking-[0.1em]">Бонусная программа</div>
    <div class="flex items-center justify-between">
      <span class="text-[14px]">Накоплено баллов</span>
      <span class="text-[24px] font-din-black leading-[1.2]">{{ available_points }} баллов</span>
    </div>
    <p class="text-[12px] text-[var(--black-50)] m-0">1 балл = 1 ₽ при следующем заказе. Баллы сгорают через 6 месяцев.</p>
  </div>

  {# TRANSACTION HISTORY #}
  {% if transactions %}
  <div class="bg-[var(--white)] rounded-2xl p-6 space-y-4">
    <div class="text-[11px] text-[var(--black-50)] font-din-black uppercase tracking-[0.1em]">История операций</div>
    <div class="space-y-2">
      {% for t in transactions %}
      <div class="flex items-center justify-between py-2 border-b border-[var(--black-4)] last:border-b-0">
        <div>
          <div class="text-[14px] font-medium">
            {{ t.description|default:t.get_type_display }}
            {% if t.order %}<span class="text-[var(--black-50)]">· Заказ #{{ t.order.pk }}</span>{% endif %}
          </div>
          <div class="text-[11px] text-[var(--black-50)]">
            {{ t.created_at|date:"d.m.Y H:i" }}
            {% if t.expires_at %} · сгорит {{ t.expires_at|date:"d.m.Y" }}{% endif %}
          </div>
        </div>
        <div class="text-[18px] font-din-black
          {% if t.type == 'earn' %}text-green-700
          {% elif t.type == 'spend' %}text-[var(--black-50)]
          {% elif t.type == 'expire' %}text-red-600
          {% else %}text-[var(--black)]{% endif %}">
          {% if t.type == 'earn' %}+{% elif t.type == 'spend' %}-{% elif t.type == 'expire' %}-{% endif %}{{ t.amount }} б.
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
