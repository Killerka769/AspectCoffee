{% extends "users/base_account.html" %}
{% load static %}

{% block title %}Мои данные{% endblock %}

{% block account_content %}
<div class="col-span-12 xl:col-span-7 2xl:col-span-6 space-y-12 md:space-y-8">

  {# === USER INFO CARD === #}
  <div class="w-full space-y-4">
    <div class="flex flex-row items-center gap-4 max-md:flex-col max-md:items-center max-md:text-center">
      {# Avatar #}
      <div class="relative shrink-0">
        <div class="w-[120px] h-[120px] rounded-full overflow-hidden bg-[var(--black-5)]">
          {% if user.avatar %}
            <img src="{{ user.avatar.url }}" alt="{{ user.get_full_name }}" class="w-full h-full object-cover">
          {% else %}
            <div class="w-full h-full flex items-center justify-center text-[48px] font-din-black text-[var(--black-50)]">
              {{ user.get_full_name|default:user.email|first|upper }}
            </div>
          {% endif %}
        </div>
        <div class="md:absolute md:top-0 md:left-0 md:w-full md:h-full md:z-10 md:bg-[var(--opacity-50)] md:rounded-full md:opacity-0 hover:opacity-100 cursor-pointer md:duration-300 max-md:hidden">
          <form method="post" enctype="multipart/form-data" class="flex flex-col items-center justify-center w-full h-full">
            {% csrf_token %}
            <input type="hidden" name="action" value="avatar">
            <label class="cursor-pointer flex flex-col items-center">
              <svg class="h-8 w-8 md:text-[var(--white)]"><use href="#icons--photo"></use></svg>
              <div class="text-[14px] leading-[1.2] md:!text-[var(--white)] md:!decoration-[transparent]">Заменить</div>
              <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="this.form.submit()">
            </label>
          </form>
        </div>
      </div>

      {# Name, phone, email #}
      <div class="flex flex-col items-start gap-1 max-md:items-center flex-1 min-w-0">
        <p class="m-0 text-[24px] font-din-black uppercase leading-[1.2] md:tracking-[0.02em]">
          {{ user.get_full_name|default:user.email }}
        </p>
        {% if user.phone %}
          <p class="m-0">{{ user.phone }}</p>
        {% endif %}
        <p class="m-0 break-all">{{ user.email }}</p>
      </div>
    </div>

    <button type="button" class="tc-btn btn-white w-full" onclick="openEditModal()">
      Редактировать данные
    </button>
  </div>

  {# === ADDRESSES === #}
  <div class="w-full space-y-4">
    <h2 class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Адреса</h2>
    <div class="-mx-4 sm:mx-0">
      <div class="flex md:!grid md:grid-cols-12 md:gap-2 max-md:overflow-auto max-md:space-x-2 px-4 sm:px-0 scrollbar-touch-hide">
        {% for address in addresses %}
          <div class="max-md:min-w-[325px] md:col-span-6 text-left bg-[var(--white)] p-4 rounded-xl hover:bg-[var(--black-5)] active:bg-[var(--black-6)] duration-300 m-0 cursor-pointer" onclick="openAddressModal('{{ address.id }}', '{{ address.label|escapejs }}', '{{ address.city|escapejs }}', '{{ address.street|escapejs }}', '{{ address.apartment|escapejs }}', '{{ address.postal_code|escapejs }}', {{ address.is_default|yesno:'true,false' }})">
            <span class="w-full flex items-center mb-1">
              <svg class="h-[24px] w-[24px] min-w-[24px] -ml-1 mr-1 offset-mac-os"><use href="#icons--pin"></use></svg>
              {% if address.label %}
                <span class="text-[18px] font-bold break-all">{{ address.label }}</span>
              {% endif %}
            </span>
            <span class="w-full block text-left">{{ address.city }}, {{ address.street }}{% if address.apartment %}, {{ address.apartment }}{% endif %}</span>
            <span class="w-full block text-left text-[14px] text-[var(--black-50)]">Индекс: {{ address.postal_code|default:"—" }}</span>
          </div>
        {% endfor %}
        <button type="button" onclick="openAddressModal()" class="max-md:min-w-[325px] md:col-span-6 text-left bg-[var(--white)] pt-2 px-4 pb-4 rounded-xl flex flex-col hover:bg-[var(--black-5)] active:bg-[var(--black-6)] duration-300 m-0 border-0 cursor-pointer">
          <svg class="h-[32px] w-[32px] mb-auto -ml-1.5"><use href="#icons--plus"></use></svg>
          <span class="text-[18px] font-bold flex">Новый адрес</span>
        </button>
      </div>
    </div>
  </div>

  {# === SAVED CARDS === #}
  <div class="w-full space-y-4">
    <h2 class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Карты</h2>
    <div class="-mx-4 sm:mx-0">
      <div class="flex md:!grid md:grid-cols-12 md:gap-2 max-md:overflow-auto max-md:space-x-2 px-4 sm:px-0 scrollbar-touch-hide">
        <button type="button" class="max-md:min-w-[325px] md:col-span-4 text-left bg-[var(--white)] pt-2 px-4 pb-4 rounded-xl flex flex-col hover:bg-[var(--black-5)] active:bg-[var(--black-6)] duration-300 m-0">
          <svg class="h-[32px] w-[32px] mb-auto -ml-1.5"><use href="#icons--plus"></use></svg>
          <span class="text-[18px] font-bold flex">Новая карта</span>
        </button>
      </div>
    </div>
    <p class="text-[14px] leading-[1.2] text-[var(--black-30)] m-0">Для проверки карты спишется 1 <span class="rub">₽</span> и сразу вернётся</p>
  </div>

</div>
{% endblock %}

{% block account_modal %}
<style>
#edit-modal { display: none !important; position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(0,0,0,0.75) !important; z-index: 99999 !important; align-items: flex-start !important; justify-content: center !important; overflow-y: auto !important; padding: 2rem 1rem !important; }
#edit-modal.show { display: flex !important; }
#address-modal { display: none !important; position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(0,0,0,0.75) !important; z-index: 99999 !important; align-items: center !important; justify-content: center !important; overflow-y: auto !important; padding: 1rem !important; }
#address-modal.show { display: flex !important; }
</style>
{# === EDIT MODAL === #}
<div id="edit-modal">
  <div class="bg-white rounded-2xl w-full max-w-2xl mx-auto my-auto max-h-[calc(100vh-4rem)] overflow-y-auto p-6 md:p-8 relative" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-6">
      <p class="text-[32px] md:text-[40px] font-din-black uppercase leading-[1.2] md:tracking-[0.01em] m-0">Редактировать данные</p>
      <button type="button" onclick="closeEditModal()" class="text-[var(--black-50)] hover:text-[var(--black)] shrink-0 ml-4">
        <svg class="h-6 w-6"><use href="#icons--x-light"></use></svg>
      </button>
    </div>
    <form method="post" action="{% url 'users:profile' %}" class="space-y-6 md:space-y-8">
      {% csrf_token %}
      <div class="space-y-4">
        <div class="tc-input"><div class="tc-input__field"><input type="text" name="first_name" value="{{ user.first_name }}" placeholder="Имя" class="tc-input__field--input"></div></div>
        <div class="tc-input"><div class="tc-input__field"><input type="text" name="last_name" value="{{ user.last_name }}" placeholder="Фамилия" class="tc-input__field--input"></div></div>
        <div class="tc-input"><div class="tc-input__field"><input type="tel" name="phone" value="{{ user.phone }}" placeholder="Телефон" class="tc-input__field--input"></div></div>
      </div>
      <hr class="border-[var(--black-4)]">
      <div class="space-y-4">
        <p class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Аккаунт</p>
        <div class="tc-input"><div class="tc-input__field"><input type="email" value="{{ user.email }}" class="tc-input__field--input" disabled></div></div>
        <div class="tc-input"><div class="tc-input__field"><input type="password" value="********" class="tc-input__field--input" disabled><button type="button" onclick="togglePasswordForm()" class="tc-input__field--btn-right tc-btn btn-xs" style="text-decoration:none;cursor:pointer;">Сменить</button></div></div>
        <div id="password-change-form" style="display:none;" class="space-y-3 p-4 rounded-xl">
          <div class="tc-input"><div class="tc-input__field"><input type="password" name="current_password" placeholder="Текущий пароль" class="tc-input__field--input"></div></div>
          <div class="tc-input"><div class="tc-input__field"><input type="password" name="new_password" placeholder="Новый пароль (мин. 8 символов)" class="tc-input__field--input"></div></div>
          <div class="tc-input"><div class="tc-input__field"><input type="password" name="new_password2" placeholder="Подтвердите новый пароль" class="tc-input__field--input"></div></div>
          <div id="pwd-errors" class="space-y-1"></div>
          <div class="flex gap-2">
            <button type="button" onclick="submitPasswordChange()" class="tc-btn btn-dark btn-xs flex-1">Сохранить пароль</button>
            <button type="button" onclick="togglePasswordForm()" class="tc-btn btn-secondary btn-xs">Отмена</button>
          </div>
        </div>
      </div>
      <hr class="border-[var(--black-4)]">

      <div class="space-y-4">
        <p class="text-[24px] font-din-black uppercase leading-[1.2] m-0">Организация</p>
        <div class="tc-input">
          <div class="tc-input__field">
            <input type="text" name="company_name" value="{{ user.company_name }}" placeholder="Название организации" class="tc-input__field--input">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="tc-input">
            <div class="tc-input__field">
              <input type="text" name="company_inn" value="{{ user.company_inn }}" placeholder="ИНН" class="tc-input__field--input" maxlength="12">
            </div>
          </div>
          <div class="tc-input">
            <div class="tc-input__field">
              <input type="text" name="company_kpp" value="{{ user.company_kpp }}" placeholder="КПП" class="tc-input__field--input" maxlength="9">
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <button type="submit" class="tc-btn btn-dark w-full">Сохранить</button>
        <button type="button" class="tc-btn btn-secondary w-full" onclick="closeEditModal()">Отменить</button>
      </div>
    </form>
  </div>
</div>

{# === ADDRESS MODAL === #}
<div id="address-modal">
  <div class="bg-white rounded-2xl w-full max-w-md mx-auto my-auto max-h-[calc(100vh-2rem)] overflow-y-auto p-6 md:p-8 relative" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-6">
      <p id="addr-modal-title" class="text-[32px] md:text-[40px] font-din-black uppercase leading-[1.2] md:tracking-[0.01em] m-0">Новый адрес</p>
      <button type="button" onclick="closeAddressModal()" class="text-[var(--black-50)] hover:text-[var(--black)] shrink-0 ml-4">
        <svg class="h-6 w-6"><use href="#icons--x-light"></use></svg>
      </button>
    </div>
    <form id="address-form" method="post" action="{% url 'users:addresses' %}" class="space-y-4" autocomplete="off">
      {% csrf_token %}
      <input type="hidden" name="action" id="addr-action" value="add">
      <input type="hidden" name="id" id="addr-id" value="">
      <input type="hidden" name="next" value="{% url 'users:profile' %}">
      <div class="tc-input">
        <label class="tc-input__label">Название</label>
        <div class="tc-input__field">
          <input type="text" name="label" id="addr-label" placeholder="Например, дом или работа" class="tc-input__field--input">
        </div>
      </div>
      <div class="tc-input">
        <label class="tc-input__label">Город</label>
        <div class="tc-input__field">
          <input type="text" name="city" id="addr-city" placeholder="Укажите город" class="tc-input__field--input">
        </div>
      </div>
      <div class="tc-input">
        <label class="tc-input__label">Улица, дом</label>
        <div class="tc-input__field">
          <input type="text" name="street" id="addr-street" placeholder="Введите адрес" class="tc-input__field--input">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="tc-input">
          <label class="tc-input__label">Квартира или офис</label>
          <div class="tc-input__field">
            <input type="text" name="apartment" id="addr-apartment" placeholder="Номер" class="tc-input__field--input">
          </div>
        </div>
        <div class="tc-input">
          <label class="tc-input__label">Индекс</label>
          <div class="tc-input__field">
            <input type="text" name="postal_code" id="addr-postal_code" placeholder="Индекс" class="tc-input__field--input">
          </div>
        </div>
      </div>
      <label class="tc-checkbox cursor-pointer">
        <input type="checkbox" name="is_default" id="addr-is_default" class="tc-checkbox__input cursor-pointer">
        <span class="tc-checkbox__text">Сделать основным</span>
      </label>
      <div class="w-full space-y-2 pt-2">
        <button type="submit" class="tc-btn btn-dark w-full">Сохранить</button>
        <button type="button" class="tc-btn btn-secondary w-full" onclick="closeAddressModal()">Отменить</button>
      </div>
      <button type="button" id="addr-delete-btn" class="tc-btn btn-danger w-full" onclick="deleteAddress()" style="display:none;">
        <svg class="h-5 w-5"><use href="#icons--delete"></use></svg>
        <span>Удалить</span>
      </button>
    </form>
  </div>
</div>

<script>
function togglePasswordForm() {
  var f = document.getElementById('password-change-form');
  if (!f) return;
  f.style.display = f.style.display === 'none' ? 'block' : 'none';
  document.getElementById('pwd-errors').innerHTML = '';
}
function submitPasswordChange() {
  var form = document.getElementById('password-change-form');
  var cur = form.querySelector('[name=current_password]').value;
  var np = form.querySelector('[name=new_password]').value;
  var np2 = form.querySelector('[name=new_password2]').value;
  var errBox = document.getElementById('pwd-errors');
  errBox.innerHTML = '';
  if (!cur) { errBox.innerHTML = '<div class="p-2 rounded-lg text-[13px]" style="background:#fee2e2;color:#991b1b;">Введите текущий пароль</div>'; return; }
  if (np.length < 8) { errBox.innerHTML = '<div class="p-2 rounded-lg text-[13px]" style="background:#fee2e2;color:#991b1b;">Пароль должен быть не менее 8 символов</div>'; return; }
  if (np !== np2) { errBox.innerHTML = '<div class="p-2 rounded-lg text-[13px]" style="background:#fee2e2;color:#991b1b;">Пароли не совпадают</div>'; return; }

  var fd = new FormData();
  fd.append('current_password', cur);
  fd.append('new_password', np);
  fd.append('new_password2', np2);
  fd.append('csrfmiddlewaretoken', '{{ csrf_token }}');
  fetch('{% url "users:change_password" %}', {
    method: 'POST',
    body: fd,
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  }).then(function(r) { return r.json().then(function(data) { return {ok: r.ok, data: data}; }); }).then(function(res) {
    if (res.ok && res.data.ok) {
      window.dispatchEvent(new CustomEvent('notify', { detail: { message: 'Пароль успешно изменён', type: 'success' } }));
      togglePasswordForm();
      form.querySelectorAll('input').forEach(function(i) { i.value = ''; });
    } else {
      errBox.innerHTML = '<div class="p-2 rounded-lg text-[13px]" style="background:#fee2e2;color:#991b1b;">' + (res.data.error || 'Ошибка смены пароля') + '</div>';
    }
  }).catch(function() {
    errBox.innerHTML = '<div class="p-2 rounded-lg text-[13px]" style="background:#fee2e2;color:#991b1b;">Ошибка. Проверьте текущий пароль.</div>';
  });
}
function openEditModal() {
  const modal = document.getElementById('edit-modal');
  if (!modal) return;
  modal.classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeEditModal() {
  const modal = document.getElementById('edit-modal');
  if (!modal) return;
  modal.classList.remove('show');
  document.body.style.overflow = '';
  var pf = document.getElementById('password-change-form');
  if (pf) pf.style.display = 'none';
}
function openAddressModal(id, label, city, street, apartment, postalCode, isDefault) {
  const modal = document.getElementById('address-modal');
  if (!modal) return;
  var title = document.getElementById('addr-modal-title');
  var actionInput = document.getElementById('addr-action');
  var idInput = document.getElementById('addr-id');
  var deleteBtn = document.getElementById('addr-delete-btn');
  document.getElementById('addr-label').value = label || '';
  document.getElementById('addr-city').value = city || '';
  document.getElementById('addr-street').value = street || '';
  document.getElementById('addr-apartment').value = apartment || '';
  document.getElementById('addr-postal_code').value = postalCode || '';
  document.getElementById('addr-is_default').checked = isDefault || false;
  if (id) {
    title.textContent = 'Изменить адрес';
    actionInput.value = 'edit';
    idInput.value = id;
    deleteBtn.style.display = '';
  } else {
    title.textContent = 'Новый адрес';
    actionInput.value = 'add';
    idInput.value = '';
    deleteBtn.style.display = 'none';
  }
  modal.classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeAddressModal() {
  const modal = document.getElementById('address-modal');
  if (!modal) return;
  modal.classList.remove('show');
  document.body.style.overflow = '';
}
function deleteAddress() {
  var id = document.getElementById('addr-id').value;
  if (!id) return;
  if (!confirm('Удалить адрес?')) return;
  var fd = new FormData();
  fd.append('action', 'delete');
  fd.append('id', id);
  fd.append('csrfmiddlewaretoken', '{{ csrf_token }}');
  fetch('{% url "users:addresses" %}', { method: 'POST', body: fd })
    .then(function() { window.location.reload(); });
}
document.addEventListener('DOMContentLoaded', function() {
  const editModal = document.getElementById('edit-modal');
  if (editModal) {
    editModal.addEventListener('click', function(e) {
      if (e.target === editModal) closeEditModal();
    });
  }
  const addressModal = document.getElementById('address-modal');
  if (addressModal) {
    addressModal.addEventListener('click', function(e) {
      if (e.target === addressModal) closeAddressModal();
    });
  }
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closeEditModal(); closeAddressModal(); }
});
</script>
{% endblock %}
