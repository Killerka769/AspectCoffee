{% if reviews %}
  {% for review in reviews %}
  <div class="review-card">
    <div class="review-header">
      <div class="review-avatar">
        {% if review.user and review.user.avatar %}
          <img src="{{ review.user.avatar.url }}" alt="" loading="lazy">
        {% endif %}
        <div class="review-avatar-letter">
          {% if review.user %}{{ review.user.first_name|first|default:review.user.email|first|upper }}{% else %}{{ review.author_name|first|default:"?"|upper }}{% endif %}
        </div>
      </div>
      <div class="review-meta">
        <p class="review-name">{% if review.user %}{{ review.user.first_name|default:review.user.email }}{% else %}{{ review.author_name|default:"Аноним" }}{% endif %}</p>
        <p class="review-date">{{ review.created_at|date:"d E Y" }}</p>
      </div>
    </div>

    <div class="review-body">
      <div class="review-rating-line">
        <p class="review-rating-label">Магазин</p>
        <div class="review-stars">
          {% for i in "12345" %}{% if forloop.counter <= review.rating %}<span class="review-star">&#9733;</span>{% else %}<span class="review-star-empty">&#9733;</span>{% endif %}{% endfor %}
        </div>
      </div>
      <p class="review-text">{{ review.text }}</p>

      {% if review.delivery_rating or review.delivery_operator or review.delivery_text %}
      <div class="review-rating-line" style="margin-top:16px;">
        <p class="review-rating-label">Доставка{% if review.delivery_operator %} {{ review.delivery_operator }}{% endif %}</p>
        {% if review.delivery_rating %}
        <div class="review-stars">
          {% for i in "12345" %}{% if forloop.counter <= review.delivery_rating %}<span class="review-star">&#9733;</span>{% else %}<span class="review-star-empty">&#9733;</span>{% endif %}{% endfor %}
        </div>
        {% endif %}
      </div>
      {% if review.delivery_text %}
      <p class="review-text" style="margin-top:8px;">{{ review.delivery_text }}</p>
      {% endif %}
      {% endif %}
    </div>
  </div>
  {% endfor %}
{% else %}
  <div class="review-card" style="text-align:center;padding:64px 24px;">
    <p style="font-size:18px;font-weight:700;margin:0 0 8px 0;">Отзывов пока нет</p>
    <p style="font-size:14px;color:var(--black-50);margin:0;">Будьте первым, кто оставит отзыв о нашем кофе.</p>
  </div>
{% endif %}
