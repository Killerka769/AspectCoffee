# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=aspectcoffee.ru,www.aspectcoffee.ru
CORS_ALLOWED_ORIGINS=https://aspectcoffee.ru,https://www.aspectcoffee.ru
JWT_SECRET_KEY=replace-with-a-separate-long-random-value
ENVIRONMENT=production
SENTRY_DSN=

# Celery / Redis. Docker Compose defaults work when these values are omitted.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMTP: production sends from Docker to host Postfix over the internal bridge.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=172.18.0.1
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Aspect Coffee <info@aspectcoffee.ru>
ADMIN_EMAIL=info@aspectcoffee.ru

# YooKassa. Use credentials of a test shop for testing and live credentials in production.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# CDEK. Change both credentials and API URL together when switching environments.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Empty URL selects the official endpoint from CDEK_TEST_MODE.
CDEK_API_URL=
CDEK_TEST_MODE=False
PAYMENT_COD_ENABLED=False

# Web Push. Never commit the private PEM file.
WEBPUSH_VAPID_PRIVATE_KEY=/run/secrets/vapid_private.pem
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:info@aspectcoffee.ru

# Optional signed deploy webhook. Leave disabled unless a deployment script is installed.
DEPLOY_SECRET=
DEPLOY_PATH=/opt/aspectcoffee
