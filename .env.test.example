# Isolated test environment. Copy to .env.test and replace both secrets.
DJANGO_SETTINGS_MODULE=config.settings.test_server
SECRET_KEY=replace-with-a-long-random-test-only-value
JWT_SECRET_KEY=replace-with-another-long-random-test-only-value
DEBUG=False
ALLOWED_HOSTS=test.aspectcoffee.ru,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://test.aspectcoffee.ru
CSRF_TRUSTED_ORIGINS=https://test.aspectcoffee.ru
ENVIRONMENT=test

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Test mail is written only to container logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Aspect Coffee TEST <test@aspectcoffee.ru>

# Never place production credentials in this file.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_URL=https://api.edu.cdek.ru/v2
CDEK_TEST_MODE=True
SENTRY_DSN=

WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:aspectcoffeeroasters@gmail.com
DEPLOY_SECRET=
